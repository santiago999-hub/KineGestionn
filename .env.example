# Plantilla de configuración sensible para docker-compose.
#
# Copiar este archivo a `.env` (en la raíz) y ajustar los valores.
# `.env` está en .gitignore: NUNCA commitear credenciales reales.
#
# IMPORTANTE: el Password dentro de KINEGESTION_CONNECTION_STRING debe coincidir
# con MSSQL_SA_PASSWORD para que la web pueda autenticarse contra SQL Server.

# Contraseña del usuario sa de SQL Server (contenedor mssql)
MSSQL_SA_PASSWORD=KineGestion_Prod_2026!

# Cadena de conexión completa que usa la web (contenedor web -> servicio mssql).
# Host interno del contenedor: Server=mssql
KINEGESTION_CONNECTION_STRING=Server=mssql;Database=KineGestionDB;User Id=sa;Password=KineGestion_Prod_2026!;TrustServerCertificate=True;MultipleActiveResultSets=True

# Cuenta admin inicial que crea el seed al arrancar (si no existe)
KINEGESTION_ADMIN_EMAIL=admin@kinegestion.com
KINEGESTION_ADMIN_PASSWORD=KineGestion_Prod_2026!01

# Hosts permitidos para Host header validation (HARDENING). En producción:
# incluir el dominio real, p.ej. "kinegestion.midominio.com;localhost"
KINEGESTION_ALLOWED_HOSTS=localhost;127.0.0.1