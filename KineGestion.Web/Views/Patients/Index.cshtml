@model KineGestion.Web.Models.ViewModels.PatientIndexViewModel

@{
    ViewData["Title"] = "Pacientes";
}

@functions {
    string FormatPhone(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return string.Empty;
        var digits = new string(value.Where(char.IsDigit).ToArray());
        if (digits.Length == 0) return value;
        if (digits.Length == 10) return digits.Substring(0, 2) + " " + digits.Substring(2, 4) + "-" + digits.Substring(6, 4);
        if (digits.Length == 11) return digits.Substring(0, 3) + " " + digits.Substring(3, 4) + "-" + digits.Substring(7, 4);
        return digits.Length > 14 ? digits.Substring(0, 14) + "…" : digits;
    }
}

<div class="kg-page-header">
    <div>
        <h2>Pacientes</h2>
        <p class="text-muted mb-0">Gestión del padrón de pacientes activos</p>
    </div>
    <a asp-action="Create" class="btn-kg-primary">
        <i class="bi bi-person-plus-fill"></i> Nuevo Paciente
    </a>
</div>

<div class="kg-card">
    <div class="kg-card-header">
        <h5 class="kg-card-header-title">
            <i class="bi bi-people-fill"></i> Listado de Pacientes
        </h5>
        <span class="kg-badge kg-badge-muted">@Model.TotalCount registros</span>
    </div>

    <form method="get" class="px-3 pt-3 pb-1">
        <div class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label small text-muted">Buscar</label>
                <input name="search" value="@Model.Search" class="form-control" placeholder="Nombre, apellido, DNI u obra social" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn-kg-primary w-100"><i class="bi bi-search"></i></button>
                <a asp-action="Index" class="btn-kg-outline w-100"><i class="bi bi-x-lg"></i></a>
            </div>
        </div>
    </form>

    @if (!Model.Items.Any())
    {
        <partial name="_EmptyState" model="@(new KineGestion.Web.Models.ViewModels.EmptyStateViewModel { IconClass = "bi bi-people", Title = "Sin pacientes registrados", Text = "Todavía no hay pacientes en el sistema.", ActionName = "Create", ActionText = "Registrar el primero", ActionIcon = "bi bi-person-plus-fill" })" />
    }
    else
    {
        <div class="table-responsive">
            <table class="kg-table">
                <thead>
                    <tr>
                        <th>Paciente</th>
                        <th>DNI</th>
                        <th>Obra Social</th>
                        <th>Teléfono</th>
                        <th>Estado</th>
                        <th class="kg-table-actions-header">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="kg-cell-user">
                                    <div class="kg-cell-avatar is-blue">
                                        @(p.Nombre.Length > 0 ? p.Nombre[0].ToString().ToUpper() : "?")@(p.Apellido.Length > 0 ? p.Apellido[0].ToString().ToUpper() : "")
                                    </div>
                                    <div class="kg-cell-primary">@p.Apellido, @p.Nombre</div>
                                </div>
                            </td>
                            <td><span class="kg-mono small">@p.DNI</span></td>
                            <td>@(string.IsNullOrEmpty(p.ObraSocial) ? "—" : p.ObraSocial)</td>
                            <td>
                                @if (string.IsNullOrEmpty(p.Telefono))
                                {
                                    <span>—</span>
                                }
                                else
                                {
                                    <span class="kg-phone" title="@p.Telefono">@FormatPhone(p.Telefono)</span>
                                }
                            </td>
                            <td>
                                @if (p.IsActivo)
                                {
                                    <span class="kg-badge kg-badge-success"><i class="bi bi-circle-fill kg-badge-dot"></i> Activo</span>
                                }
                                else
                                {
                                    <span class="kg-badge kg-badge-muted">Inactivo</span>
                                }
                            </td>
                            <td>
                                <div class="kg-action-btns kg-action-btns-end">
                                    <a asp-action="Details" asp-route-id="@p.Id" class="kg-action-btn view" title="Ver detalle"><i class="bi bi-eye-fill"></i></a>
                                    <a asp-action="Edit" asp-route-id="@p.Id" class="kg-action-btn edit" title="Editar"><i class="bi bi-pencil-fill"></i></a>
                                    <a asp-action="Delete" asp-route-id="@p.Id" class="kg-action-btn del" title="Dar de baja"><i class="bi bi-trash-fill"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="kg-table-footer">
            Mostrando @Model.Items.Count() de @Model.TotalCount pacientes activos
        </div>

        var paginationRouteValues = new Dictionary<string, string>();
        paginationRouteValues["pageSize"] = Model.PageSize.ToString();
        if (!string.IsNullOrWhiteSpace(Model.Search)) { paginationRouteValues["search"] = Model.Search!; }
        <partial name="_Pagination" model="@(new KineGestion.Web.Models.ViewModels.PaginationViewModel { Page = Model.Page, TotalPages = Model.TotalPages, Action = "Index", RouteValues = paginationRouteValues })" />
    }
</div>
