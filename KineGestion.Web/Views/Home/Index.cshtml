@model KineGestion.Web.Models.ViewModels.HomeDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    var today = DateTime.Today;
    var todayIso = today.ToString("yyyy-MM-dd");
    var todayDisplay = today.ToString("dd/MM/yyyy");
    var isAdmin = User.IsInRole("Admin");
    var isKinesiologo = User.IsInRole("Kinesiologo");
    var offices = ViewData["Offices"] as List<KineGestion.Core.Entities.Office> ?? new List<KineGestion.Core.Entities.Office>();
    var selectedOffice = Model.SelectedOfficeId.HasValue ? offices.FirstOrDefault(o => o.Id == Model.SelectedOfficeId.Value) : null;
    var selectedLabel = selectedOffice != null ? $"Oficina {selectedOffice.Id} - {selectedOffice.Name}" : "Todas las sedes";
    var last30Start = today.AddDays(-29);
    var last30StartIso = last30Start.ToString("yyyy-MM-dd");
}

<div class="kg-dashboard-hero mb-4">
    <div class="kg-dashboard-hero-copy">
        <div class="kg-dashboard-hero-kicker">
            <i class="bi bi-speedometer2"></i>
            Panel operativo
        </div>
        <h2>Tu centro de control para el día de trabajo</h2>
        <p>
            Acá tenés el estado general del sistema, los indicadores que importan y los accesos rápidos
            para resolver la operación clínica sin navegar de más.
        </p>
        <div class="kg-dashboard-hero-actions">
            <a asp-controller="Sessions" asp-action="Index" asp-route-dateFrom="@todayIso" asp-route-dateTo="@todayIso" class="btn-kg-primary">
                <i class="bi bi-calendar2-week-fill"></i>
                Ver agenda de hoy
            </a>
            <a asp-controller="Home" asp-action="QuienesSomos" class="btn-kg-outline">
                <i class="bi bi-info-circle"></i>
                Conocer la plataforma
            </a>
        </div>
    </div>

<div class="kg-dashboard-hero-meta">
        <div class="kg-dashboard-hero-chip">
            <i class="bi bi-calendar3"></i>
            <span>@todayDisplay</span>
        </div>
        <div class="kg-dashboard-hero-chip">
            <i class="bi bi-activity"></i>
            <span>Sesión protegida y auditada</span>
        </div>
        <div class="kg-dashboard-hero-chip">
            <i class="bi bi-shield-check"></i>
            <span>@User.Identity?.Name</span>
        </div>
        @if (isAdmin)
        {
            <form asp-controller="Home" asp-action="Index" method="post" class="kg-office-form" id="kgOfficeForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="officeId" id="kgOfficeValue" value="@(Model.SelectedOfficeId?.ToString() ?? "")" />
                <div class="kg-hero-dropdown" id="kgOfficeDropdown">
                    <button type="button"
                            class="kg-hero-select"
                            id="kgOfficeTrigger"
                            aria-haspopup="listbox"
                            aria-expanded="false"
                            aria-controls="kgOfficeList"
                            aria-label="Seleccionar sede">
                        <i class="bi bi-building-fill kg-hero-select-icon" aria-hidden="true"></i>
                        <span class="kg-hero-select-label" id="kgOfficeLabel">@selectedLabel</span>
                        <i class="bi bi-chevron-down kg-hero-select-caret" aria-hidden="true"></i>
                    </button>

                    <div class="kg-hero-menu" id="kgOfficeList" role="listbox" aria-label="Sedes disponibles" tabindex="-1">
                        <button type="button" class="kg-hero-option @(Model.SelectedOfficeId.HasValue ? "" : "is-selected")" role="option" aria-selected="@(Model.SelectedOfficeId.HasValue ? "false" : "true")" data-value="" data-label="Todas las sedes">
                            <i class="bi bi-buildings" aria-hidden="true"></i>
                            <span>Todas las sedes</span>
                            <i class="bi bi-check2 kg-hero-option-check" aria-hidden="true"></i>
                        </button>
                        @foreach (var office in offices)
                        {
                            var isSel = Model.SelectedOfficeId == office.Id;
                            <button type="button" class="kg-hero-option @(isSel ? "is-selected" : "")" role="option" aria-selected="@(isSel ? "true" : "false")" data-value="@office.Id" data-label="Oficina @office.Id - @office.Name">
                                <i class="bi bi-geo-alt" aria-hidden="true"></i>
                                <span>Oficina @office.Id - @office.Name</span>
                                <i class="bi bi-check2 kg-hero-option-check" aria-hidden="true"></i>
                            </button>
                        }
                    </div>
                </div>
            </form>
        }
</div>
</div>

<!-- Page Header -->
<div class="kg-page-header">
    <div>
        <h2>Dashboard</h2>
        <p class="text-muted mb-0">Resumen operativo del centro de kinesiología</p>
    </div>
    <span class="kg-badge kg-badge-success">
        <i class="bi bi-circle-fill kg-badge-dot"></i> Sistema activo
    </span>
</div>

@if (Model.IsBillingOperationalAlertActive)
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center mb-3" role="alert">
        <div>
            <strong>Alerta operativa activa:</strong>
            Se detectaron 2 semanas consecutivas con baja efectividad de cobranzas.
            @if (Model.IsBillingOperationalAlertSentToday)
            {
                <span class="ms-2">Notificación administrativa enviada hoy.</span>
            }
            @if (Model.LastBillingOperationalAlertAtUtc.HasValue)
            {
                <span class="ms-2">Último envío: @Model.LastBillingOperationalAlertAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.LastBillingOperationalAlertChangedBy))
            {
                <span class="ms-2">Disparado por: @Model.LastBillingOperationalAlertChangedBy</span>
            }
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Billing" asp-action="Index" class="btn btn-sm btn-outline-danger">Ir a Cobranzas</a>
            <a asp-controller="Reminders" asp-action="Index" class="btn btn-sm btn-outline-secondary">Ir a Recordatorios</a>
            @if (isAdmin)
            {
                <form asp-controller="Home" asp-action="TriggerBillingOperationalAlert" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger">Reintentar alerta</button>
                </form>
            }
        </div>
    </div>

    @if (Model.RecentBillingOperationalAlerts.Count > 0)
    {
        <div class="alert alert-light border mb-3" role="status">
            <strong>Últimas alertas operativas:</strong>
            <ul class="mb-0 mt-2">
                @foreach (var item in Model.RecentBillingOperationalAlerts)
                {
                    <li class="d-flex flex-wrap align-items-center gap-2">
                        <span>
                            @item.ChangedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm") -
                            <span class="fw-semibold @(item.IsSystemTriggered ? "text-secondary" : "text-primary")">
                                @item.ChangedBy
                            </span>
                        </span>
                        <span class="badge kg-alert-origin-badge @(item.IsSystemTriggered ? "text-bg-secondary" : "text-bg-primary")"
                            tabindex="0"
                            title="@((item.IsSystemTriggered ? "Origen automático por sistema" : "Origen manual disparado por usuario"))"
                            aria-label="@($"Origen de alerta: {item.TriggerSourceLabel}. {(item.IsSystemTriggered ? "Disparo automático por sistema" : "Disparo manual por usuario")}")">
                            @item.TriggerSourceLabel
                        </span>
                    </li>
                }
            </ul>
        </div>
    }
}

<!-- Indicadores clave -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
        <div class="kg-stat-card">
            <div class="kg-stat-icon green"><i class="bi bi-graph-up-arrow"></i></div>
            <div>
                <div class="kg-stat-label">Cumplimiento hoy</div>
                <div class="kg-stat-value @(Model.CompletionRateToday == 0 ? "is-empty" : "")">@Model.CompletionRateToday.ToString("N2")%</div>
                <small class="text-muted">Completadas sobre sesiones del día</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <a asp-controller="Billing" asp-action="Index" class="kg-stat-card kg-stat-link">
            <div class="kg-stat-icon cyan"><i class="bi bi-cash-stack"></i></div>
            <div>
                <div class="kg-stat-label">Tasa de cobranza (30d)</div>
                <div class="kg-stat-value @(Model.CollectionRateLast30Days == 0 ? "is-empty" : "")">@Model.CollectionRateLast30Days.ToString("N2")%</div>
                <small class="text-muted">Completadas pagadas sobre completadas</small>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-4">
        <a asp-controller="Sessions" asp-action="Index" asp-route-dateFrom="@last30StartIso" asp-route-dateTo="@todayIso" class="kg-stat-card kg-stat-link">
            <div class="kg-stat-icon orange"><i class="bi bi-exclamation-circle"></i></div>
            <div>
                <div class="kg-stat-label">Tasa de cancelación (30d)</div>
                <div class="kg-stat-value @(Model.CancellationRateLast30Days == 0 ? "is-empty" : "")">@Model.CancellationRateLast30Days.ToString("N2")%</div>
                <small class="text-muted">Canceladas sobre total agendado</small>
            </div>
        </a>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="kg-stat-card">
            <div class="kg-stat-icon blue"><i class="bi bi-people-fill"></i></div>
            <div>
                <div class="kg-stat-label">Pacientes activos</div>
                <div class="kg-stat-value @(Model.PacientesActivosCount == 0 ? "is-empty" : "")">@Model.PacientesActivosCount</div>
                @if (Model.PacientesActivosCount == 0)
                {
                    <div class="kg-stat-empty">Sin pacientes registrados</div>
                }
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kg-stat-card">
            <div class="kg-stat-icon cyan"><i class="bi bi-person-badge-fill"></i></div>
            <div>
                <div class="kg-stat-label">Profesionales</div>
                <div class="kg-stat-value @(Model.ProfesionalesActivosCount == 0 ? "is-empty" : "")">@Model.ProfesionalesActivosCount</div>
                @if (Model.ProfesionalesActivosCount == 0)
                {
                    <div class="kg-stat-empty">Sin profesionales activos</div>
                }
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kg-stat-card">
            <div class="kg-stat-icon green"><i class="bi bi-journal-medical"></i></div>
            <div>
                <div class="kg-stat-label">Tratamientos</div>
                <div class="kg-stat-value @(Model.TratamientosCount == 0 ? "is-empty" : "")">@Model.TratamientosCount</div>
                @if (Model.TratamientosCount == 0)
                {
                    <div class="kg-stat-empty">Sin planes terapéuticos cargados</div>
                }
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kg-stat-card">
            <div class="kg-stat-icon violet"><i class="bi bi-calendar2-check-fill"></i></div>
            <div>
                <div class="kg-stat-label">Sesiones</div>
                <div class="kg-stat-value @(Model.SesionesCount == 0 ? "is-empty" : "")">@Model.SesionesCount</div>
                @if (Model.SesionesCount == 0)
                {
                    <div class="kg-stat-empty">Sin sesiones registradas</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Operational Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Sessions" asp-action="Index" asp-route-dateFrom="@todayIso" asp-route-dateTo="@todayIso" class="kg-stat-card kg-stat-link">
            <div class="kg-stat-icon orange"><i class="bi bi-calendar2-day-fill"></i></div>
            <div>
                <div class="kg-stat-label">Sesiones hoy</div>
                <div class="kg-stat-value @(Model.SesionesHoyCount == 0 ? "is-empty" : "")">@Model.SesionesHoyCount</div>
                @if (Model.SesionesHoyCount == 0)
                {
                    <div class="kg-stat-empty">No hay sesiones agendadas para hoy</div>
                }
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Sessions" asp-action="Index" asp-route-status="Completed" asp-route-dateFrom="@todayIso" asp-route-dateTo="@todayIso" class="kg-stat-card kg-stat-link">
            <div class="kg-stat-icon green"><i class="bi bi-check2-circle"></i></div>
            <div>
                <div class="kg-stat-label">Completadas hoy</div>
                <div class="kg-stat-value @(Model.SesionesCompletadasHoyCount == 0 ? "is-empty" : "")">@Model.SesionesCompletadasHoyCount</div>
                @if (Model.SesionesCompletadasHoyCount == 0)
                {
                    <div class="kg-stat-empty">Nada completado todavía</div>
                }
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Billing" asp-action="Index" asp-route-onlyCompletedPending="true" class="kg-stat-card kg-stat-link">
            <div class="kg-stat-icon red"><i class="bi bi-credit-card-fill"></i></div>
            <div>
                <div class="kg-stat-label">Completadas sin cobrar</div>
                <div class="kg-stat-value @(Model.SesionesPendientesPagoCount == 0 ? "is-empty" : "")">@Model.SesionesPendientesPagoCount</div>
                @if (Model.SesionesPendientesPagoCount == 0)
                {
                    <div class="kg-stat-empty">Sin cobros pendientes</div>
                }
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Sessions" asp-action="Index" asp-route-status="Pending" class="kg-stat-card kg-stat-link">
            <div class="kg-stat-icon yellow"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <div class="kg-stat-label">Sin confirmar</div>
                <div class="kg-stat-value @(Model.SesionesPendientesConfirmacionCount == 0 ? "is-empty" : "")">@Model.SesionesPendientesConfirmacionCount</div>
                @if (Model.SesionesPendientesConfirmacionCount == 0)
                {
                    <div class="kg-stat-empty">Todas las sesiones están confirmadas</div>
                }
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Sessions" asp-action="Index" asp-route-status="Canceled" asp-route-dateFrom="@todayIso" asp-route-dateTo="@todayIso" class="kg-stat-card kg-stat-link">
            <div class="kg-stat-icon orange"><i class="bi bi-x-circle-fill"></i></div>
            <div>
                <div class="kg-stat-label">Canceladas hoy</div>
                <div class="kg-stat-value @(Model.SesionesCanceladasHoyCount == 0 ? "is-empty" : "")">@Model.SesionesCanceladasHoyCount</div>
                @if (Model.SesionesCanceladasHoyCount == 0)
                {
                    <div class="kg-stat-empty">Sin cancelaciones hoy</div>
                }
            </div>
        </a>
    </div>
</div>

<!-- Rendimiento 30 días -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
        <div class="kg-stat-card">
            <div class="kg-stat-icon green"><i class="bi bi-graph-up-arrow"></i></div>
            <div>
                <div class="kg-stat-label">Cumplimiento hoy</div>
                <div class="kg-stat-value @(Model.CompletionRateToday == 0 ? "is-empty" : "")">@Model.CompletionRateToday.ToString("N2")%</div>
                <small class="text-muted">Completadas sobre sesiones del día</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="kg-stat-card">
            <div class="kg-stat-icon cyan"><i class="bi bi-cash-stack"></i></div>
            <div>
                <div class="kg-stat-label">Tasa de cobranza (30d)</div>
                <div class="kg-stat-value @(Model.CollectionRateLast30Days == 0 ? "is-empty" : "")">@Model.CollectionRateLast30Days.ToString("N2")%</div>
                <small class="text-muted">Sesiones pagadas sobre total de sesiones</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="kg-stat-card">
            <div class="kg-stat-icon orange"><i class="bi bi-exclamation-circle"></i></div>
            <div>
                <div class="kg-stat-label">Tasa de cancelación (30d)</div>
                <div class="kg-stat-value @(Model.CancellationRateLast30Days == 0 ? "is-empty" : "")">@Model.CancellationRateLast30Days.ToString("N2")%</div>
                <small class="text-muted">Canceladas sobre total de sesiones · tardías: @Model.LateCancellationRateLast30.ToString("N2")% (@Model.LateCancellationsLast30)</small>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions + Info -->
<div class="row g-3">
    <div class="col-lg-@(isAdmin ? "7" : "12")">
        <div class="kg-card">
            <div class="kg-card-header">
                <h5 class="kg-card-header-title">
                    <i class="bi bi-lightning-charge-fill"></i> Acciones rápidas
                </h5>
            </div>
            <div class="kg-card-body">
                <div class="kg-action-priority-label">Prioridad de hoy</div>
                <div class="kg-action-priority-strip mb-4">
                    @if (isAdmin)
                    {
                        <a asp-controller="Sessions" asp-action="Index" asp-route-paymentStatus="Pending" asp-route-dateFrom="@todayIso" asp-route-dateTo="@todayIso" class="kg-quick-action kg-quick-action-featured">
                            <i class="bi bi-cash-stack"></i>
                            <div>
                                <span class="kg-quick-action-kicker">Urgente</span>
                                <div>Pagos Pendientes de Hoy</div>
                                <div class="kg-quick-action-help">Filtrar cobros pendientes del día</div>
                            </div>
                        </a>
                        <a asp-controller="Sessions" asp-action="Index" asp-route-status="Pending" asp-route-dateFrom="@todayIso" asp-route-dateTo="@todayIso" class="kg-quick-action kg-quick-action-featured">
                            <i class="bi bi-hourglass-split"></i>
                            <div>
                                <span class="kg-quick-action-kicker">Control</span>
                                <div>Sin Confirmar de Hoy</div>
                                <div class="kg-quick-action-help">Revisar sesiones pendientes del día</div>
                            </div>
                        </a>
                        <a asp-controller="Sessions" asp-action="Index" asp-route-status="Canceled" asp-route-dateFrom="@todayIso" asp-route-dateTo="@todayIso" class="kg-quick-action kg-quick-action-featured">
                            <i class="bi bi-arrow-repeat"></i>
                            <div>
                                <span class="kg-quick-action-kicker">Seguimiento</span>
                                <div>Canceladas de Hoy</div>
                                <div class="kg-quick-action-help">Priorizar recupero y reprogramación</div>
                            </div>
                        </a>
                        <a asp-controller="Sessions" asp-action="Create" class="kg-quick-action kg-quick-action-featured">
                            <i class="bi bi-calendar2-plus-fill"></i>
                            <div>
                                <span class="kg-quick-action-kicker">Nuevo</span>
                                <div>Nueva Sesión</div>
                                <div class="kg-quick-action-help">Registrar sesión clínica</div>
                            </div>
                        </a>
                    }
                    else if (isKinesiologo)
                    {
                        <a asp-controller="Sessions" asp-action="MyAgenda" asp-route-dateFrom="@todayIso" asp-route-dateTo="@todayIso" class="kg-quick-action kg-quick-action-featured">
                            <i class="bi bi-calendar2-week-fill"></i>
                            <div>
                                <span class="kg-quick-action-kicker">Hoy</span>
                                <div>Mi Agenda de Hoy</div>
                                <div class="kg-quick-action-help">Ver solo tus turnos de hoy</div>
                            </div>
                        </a>
                        <a asp-controller="Sessions" asp-action="Create" class="kg-quick-action kg-quick-action-featured">
                            <i class="bi bi-calendar2-plus-fill"></i>
                            <div>
                                <span class="kg-quick-action-kicker">Nuevo</span>
                                <div>Nueva Sesión</div>
                                <div class="kg-quick-action-help">Registrar sesión clínica</div>
                            </div>
                        </a>
                    }
                </div>

                <div class="row g-3">
                    @if (isAdmin)
                    {
                        <div class="col-sm-6">
                            <a asp-controller="Patients" asp-action="Create" class="kg-quick-action">
                                <i class="bi bi-person-plus-fill"></i>
                                <div>
                                    <div>Nuevo Paciente</div>
                                    <div class="kg-quick-action-help">Registrar en el sistema</div>
                                </div>
                            </a>
                        </div>
                        <div class="col-sm-6">
                            <a asp-controller="Treatments" asp-action="Create" class="kg-quick-action">
                                <i class="bi bi-journal-plus"></i>
                                <div>
                                    <div>Nuevo Tratamiento</div>
                                    <div class="kg-quick-action-help">Asignar a un paciente</div>
                                </div>
                            </a>
                        </div>
                        <div class="col-sm-6">
                            <a asp-controller="Professionals" asp-action="Create" class="kg-quick-action">
                                <i class="bi bi-person-badge-fill"></i>
                                <div>
                                    <div>Nuevo Profesional</div>
                                    <div class="kg-quick-action-help">Dar de alta kinesiólogo</div>
                                </div>
                            </a>
                        </div>
                    }
                    else if (isKinesiologo)
                    {
                        <div class="col-12">
                            <partial name="_EmptyState" model="@(new KineGestion.Web.Models.ViewModels.EmptyStateViewModel { IconClass = "bi bi-clipboard2-check", Title = "Accesos operativos listos", Text = "Usá la prioridad de hoy para abrir la agenda o registrar una nueva sesión sin pasos extra.", WrapperClass = "kg-empty kg-quick-action-empty" })" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (isAdmin)
    {
        <div class="col-lg-5">
            <div class="kg-card h-100">
                <div class="kg-card-header">
                    <h5 class="kg-card-header-title">
                        <i class="bi bi-info-circle-fill"></i> Información del sistema
                    </h5>
                </div>
                <div class="kg-card-body">
                    <ul class="list-unstyled mb-0 kg-system-list">
                        <li class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Versión</span>
                            <span class="kg-badge kg-badge-primary">v1.0 — Sprint 2</span>
                        </li>
                        <li class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Base de datos</span>
                            <span class="kg-badge kg-badge-success"><i class="bi bi-circle-fill kg-badge-dot-sm"></i> SQL Server</span>
                        </li>
                        <li class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Framework</span>
                            <span class="kg-badge kg-badge-info">.NET 8 MVC</span>
                        </li>
                        <li class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Arquitectura</span>
                            <span class="kg-badge kg-badge-violet">Clean Architecture</span>
                        </li>
                        <li class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Fecha</span>
                            <span class="kg-system-date">@todayDisplay</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    }
</div>

@if (isAdmin)
{
    <div class="row g-3 mt-1">
        <div class="col-12">
            <div class="kg-card">
                <div class="kg-card-header">
                    <h5 class="kg-card-header-title">
                        <i class="bi bi-bar-chart-fill"></i> Motivos de cancelación (últimos 30 días)
                    </h5>
                    <a asp-controller="Sessions" asp-action="Index" asp-route-status="Canceled" class="kg-badge kg-badge-muted kg-link-plain">Ver canceladas</a>
                </div>
                <div class="kg-card-body">
                    @if (!Model.TopCancellationReasons.Any())
                    {
                        <p class="text-muted mb-0">Sin cancelaciones registradas con motivo en el período.</p>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var c in Model.TopCancellationReasons)
                            {
                                <div class="col-md-4 col-lg-3">
                                    <div class="kg-reason-tile">
                                        <span class="kg-badge kg-badge-danger">@c.Count</span>
                                        <div>
                                            <div class="kg-reason-label">@c.Label</div>
                                            <div class="kg-reason-sub">cancelaciones</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            var dropdown = document.getElementById('kgOfficeDropdown');
            if (!dropdown) return;

            var trigger = document.getElementById('kgOfficeTrigger');
            var menu = document.getElementById('kgOfficeList');
            var hidden = document.getElementById('kgOfficeValue');
            var label = document.getElementById('kgOfficeLabel');
            var form = document.getElementById('kgOfficeForm');
            var options = Array.prototype.slice.call(menu.querySelectorAll('.kg-hero-option'));
            var activeIndex = options.findIndex(function (o) { return o.classList.contains('is-selected'); });
            if (activeIndex < 0) activeIndex = 0;

            function isOpen() { return dropdown.classList.contains('is-open'); }

            function positionMenu() {
                var rect = trigger.getBoundingClientRect();
                var gap = 10;
                var menuHeight = Math.min(menu.scrollHeight, 300);
                var spaceBelow = window.innerHeight - rect.bottom;
                var openAbove = spaceBelow < menuHeight + gap && rect.top > menuHeight + gap;

                menu.style.left = rect.left + 'px';
                menu.style.width = rect.width + 'px';
                menu.classList.toggle('is-above', openAbove);

                if (openAbove) {
                    menu.style.top = (rect.top - menuHeight - gap) + 'px';
                } else {
                    menu.style.top = (rect.bottom + gap) + 'px';
                }
            }

            function openMenu() {
                dropdown.classList.add('is-open');
                trigger.setAttribute('aria-expanded', 'true');
                positionMenu();
                menu.focus();
                highlight(activeIndex);
            }

            function closeMenu() {
                dropdown.classList.remove('is-open');
                trigger.setAttribute('aria-expanded', 'false');
            }

            function highlight(index) {
                activeIndex = (index + options.length) % options.length;
                options.forEach(function (o, i) {
                    o.classList.toggle('is-active', i === activeIndex);
                });
                options[activeIndex].scrollIntoView({ block: 'nearest' });
            }

            function select(option) {
                hidden.value = option.dataset.value || '';
                label.textContent = option.dataset.label;
                options.forEach(function (o) {
                    var on = o === option;
                    o.classList.toggle('is-selected', on);
                    o.setAttribute('aria-selected', on ? 'true' : 'false');
                });
                closeMenu();
                trigger.focus();
                form.submit();
            }

            trigger.addEventListener('click', function () {
                isOpen() ? closeMenu() : openMenu();
            });

            trigger.addEventListener('keydown', function (e) {
                if (e.key === 'ArrowDown' || e.key === 'ArrowUp' || e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    openMenu();
                }
            });

            menu.addEventListener('keydown', function (e) {
                switch (e.key) {
                    case 'ArrowDown': e.preventDefault(); highlight(activeIndex + 1); break;
                    case 'ArrowUp': e.preventDefault(); highlight(activeIndex - 1); break;
                    case 'Home': e.preventDefault(); highlight(0); break;
                    case 'End': e.preventDefault(); highlight(options.length - 1); break;
                    case 'Enter':
                    case ' ':
                        e.preventDefault();
                        select(options[activeIndex]);
                        break;
                    case 'Escape':
                        e.preventDefault();
                        closeMenu();
                        trigger.focus();
                        break;
                    case 'Tab':
                        closeMenu();
                        break;
                }
            });

            options.forEach(function (option, i) {
                option.addEventListener('click', function () { select(option); });
                option.addEventListener('mousemove', function () { highlight(i); });
            });

            document.addEventListener('click', function (e) {
                if (!dropdown.contains(e.target) && !menu.contains(e.target)) closeMenu();
            });

            window.addEventListener('resize', function () { if (isOpen()) positionMenu(); });
            window.addEventListener('scroll', function () { if (isOpen()) positionMenu(); }, true);
        })();
    </script>
}
