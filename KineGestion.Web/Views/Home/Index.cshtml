@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/kg-chart.js" asp-append-version="true"></script>
    <script>
        (function () {
            var dropdown = document.getElementById('kgOfficeDropdown');
            if (!dropdown) return;

            var trigger = document.getElementById('kgOfficeTrigger');
            var menu = document.getElementById('kgOfficeList');
            var hidden = document.getElementById('kgOfficeValue');
            var label = document.getElementById('kgOfficeLabel');
            var form = document.getElementById('kgOfficeForm');
            var options = Array.prototype.slice.call(menu.querySelectorAll('.kg-hero-option'));
            var activeIndex = options.findIndex(function (o) { return o.classList.contains('is-selected'); });
            if (activeIndex < 0) activeIndex = 0;

            function isOpen() { return dropdown.classList.contains('is-open'); }

            function positionMenu() {
                var rect = trigger.getBoundingClientRect();
                var gap = 10;
                var menuHeight = Math.min(menu.scrollHeight, 300);
                var spaceBelow = window.innerHeight - rect.bottom;
                var openAbove = spaceBelow < menuHeight + gap && rect.top > menuHeight + gap;

                menu.style.left = rect.left + 'px';
                menu.style.width = rect.width + 'px';
                menu.classList.toggle('is-above', openAbove);

                if (openAbove) {
                    menu.style.top = (rect.top - menuHeight - gap) + 'px';
                } else {
                    menu.style.top = (rect.bottom + gap) + 'px';
                }
            }

            function openMenu() {
                dropdown.classList.add('is-open');
                trigger.setAttribute('aria-expanded', 'true');
                positionMenu();
                menu.focus();
                highlight(activeIndex);
            }

            function closeMenu() {
                dropdown.classList.remove('is-open');
                trigger.setAttribute('aria-expanded', 'false');
            }

            function highlight(index) {
                activeIndex = (index + options.length) % options.length;
                options.forEach(function (o, i) {
                    o.classList.toggle('is-active', i === activeIndex);
                });
                options[activeIndex].scrollIntoView({ block: 'nearest' });
            }

            function select(option) {
                hidden.value = option.dataset.value || '';
                label.textContent = option.dataset.label;
                options.forEach(function (o) {
                    var on = o === option;
                    o.classList.toggle('is-selected', on);
                    o.setAttribute('aria-selected', on ? 'true' : 'false');
                });
                closeMenu();
                trigger.focus();
                form.submit();
            }

            trigger.addEventListener('click', function () {
                isOpen() ? closeMenu() : openMenu();
            });

            trigger.addEventListener('keydown', function (e) {
                if (e.key === 'ArrowDown' || e.key === 'ArrowUp' || e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    openMenu();
                }
            });

            menu.addEventListener('keydown', function (e) {
                switch (e.key) {
                    case 'ArrowDown': e.preventDefault(); highlight(activeIndex + 1); break;
                    case 'ArrowUp': e.preventDefault(); highlight(activeIndex - 1); break;
                    case 'Home': e.preventDefault(); highlight(0); break;
                    case 'End': e.preventDefault(); highlight(options.length - 1); break;
                    case 'Enter':
                    case ' ':
                        e.preventDefault();
                        select(options[activeIndex]);
                        break;
                    case 'Escape':
                        e.preventDefault();
                        closeMenu();
                        trigger.focus();
                        break;
                    case 'Tab':
                        closeMenu();
                        break;
                }
            });

            options.forEach(function (option, i) {
                option.addEventListener('click', function () { select(option); });
                option.addEventListener('mousemove', function () { highlight(i); });
            });

            document.addEventListener('click', function (e) {
                if (!dropdown.contains(e.target) && !menu.contains(e.target)) closeMenu();
            });

            window.addEventListener('resize', function () { if (isOpen()) positionMenu(); });
            window.addEventListener('scroll', function () { if (isOpen()) positionMenu(); }, true);
        })();
    </script>
    <script>
        (function () {
            if (!window.kgChart) return;

            const statusLabels = @Html.Raw(statusLabelsJson);
            const statusCounts = @Html.Raw(statusCountsJson);
            const statusColors = @Html.Raw(statusColorsJson);
            const statusTotalCount = statusCounts.reduce((sum, value) => sum + value, 0);

            window.kgChart.render('homeStatusChart', (palette) => {
                const isDark = window.kgChart.isDark();
                return {
                    type: 'doughnut',
                    data: {
                        labels: statusLabels,
                        datasets: [{
                            data: statusCounts,
                            backgroundColor: statusColors,
                            borderWidth: 0,
                            borderRadius: 10,
                            spacing: 4,
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        cutout: '70%',
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: isDark ? 'rgba(9, 20, 34, 0.96)' : 'rgba(255, 255, 255, 0.98)',
                                titleColor: palette.text,
                                bodyColor: palette.muted,
                                borderColor: palette.grid,
                                borderWidth: 1,
                                padding: 10,
                                callbacks: {
                                    label: (context) => {
                                        const pct = statusTotalCount > 0 ? (statusCounts[context.dataIndex] * 100 / statusTotalCount).toFixed(1) : '0.0';
                                        return ' ' + context.parsed + ' sesiones · ' + pct + '%';
                                    }
                                }
                            }
                        }
                    }
                };
            });

            const dailyLabels = @Html.Raw(dailyLabelsJson);
            const dailyTotals = @Html.Raw(dailyTotalsJson);
            const dailyCompleted = @Html.Raw(dailyCompletedJson);

            window.kgChart.render('homeEvolutionChart', (palette) => ({
                type: 'line',
                data: {
                    labels: dailyLabels,
                    datasets: [
                        {
                            label: 'Total',
                            data: dailyTotals,
                            borderColor: palette.accent,
                            backgroundColor: window.kgChart.withAlpha(palette.accent, 0.14),
                            fill: true,
                            tension: 0.35,
                            borderWidth: 2,
                            pointRadius: 0,
                            pointHoverRadius: 4,
                            pointHoverBackgroundColor: palette.accent
                        },
                        {
                            label: 'Completadas',
                            data: dailyCompleted,
                            borderColor: palette.green,
                            backgroundColor: 'transparent',
                            tension: 0.35,
                            borderWidth: 2,
                            pointRadius: 0,
                            pointHoverRadius: 4,
                            pointHoverBackgroundColor: palette.green
                        }
                    ]
                },
                options: {
                    plugins: {
                        tooltip: Object.assign(window.kgChart.tooltipDefaults(palette), {
                            callbacks: {
                                label: (context) => ' ' + context.dataset.label + ': ' + Number(context.parsed.y).toLocaleString('es-AR')
                            }
                        })
                    },
                    scales: {
                        x: { ticks: { maxTicksLimit: 12 } },
                        y: { ticks: { precision: 0 } }
                    }
                }
            }));

            const cancellationLabels = @Html.Raw(cancellationLabelsJson);
            const cancellationCounts = @Html.Raw(cancellationCountsJson);
            const cancellationColors = @Html.Raw(cancellationColorsJson);

            window.kgChart.render('homeCancellationChart', (palette) => ({
                type: 'bar',
                data: {
                    labels: cancellationLabels,
                    datasets: [{
                        label: 'Cancelaciones',
                        data: cancellationCounts,
                        backgroundColor: cancellationColors,
                        borderRadius: 6
                    }]
                },
                options: {
                    indexAxis: 'y',
                    plugins: {
                        legend: { display: false },
                        tooltip: Object.assign(window.kgChart.tooltipDefaults(palette), {
                            callbacks: {
                                label: (context) => ' ' + context.parsed.x + ' cancelaciones'
                            }
                        })
                    }
                }
            }));
        })();
    </script>
}
