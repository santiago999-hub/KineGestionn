@model KineGestion.Web.Models.ViewModels.HomeDashboardViewModel
@using KineGestion.Core

@{
    ViewData["Title"] = "Dashboard";
    var today = DateTime.Today;
    var todayIso = today.ToString("yyyy-MM-dd");
    var todayDisplay = today.ToString("dd/MM/yyyy");
    var isAdmin = User.IsInRole("Admin");
    var isKinesiologo = User.IsInRole("Kinesiologo");
    var offices = ViewData["Offices"] as List<KineGestion.Core.Entities.Office> ?? new List<KineGestion.Core.Entities.Office>();
    var selectedOffice = Model.SelectedOfficeId.HasValue ? offices.FirstOrDefault(o => o.Id == Model.SelectedOfficeId.Value) : null;
    var selectedLabel = selectedOffice != null ? $"Oficina {selectedOffice.Id} - {selectedOffice.Name}" : "Todas las sedes";
    var last30Start = today.AddDays(-29);
    var last30StartIso = last30Start.ToString("yyyy-MM-dd");

    var statusLabelsJson = System.Text.Json.JsonSerializer.Serialize(Model.StatusDistribution.Select(s => s.Label));
    var statusCountsJson = System.Text.Json.JsonSerializer.Serialize(Model.StatusDistribution.Select(s => s.Count));
    var dailyLabelsJson = System.Text.Json.JsonSerializer.Serialize(Model.DailySessions.Select(p => p.Label));
    var dailyTotalsJson = System.Text.Json.JsonSerializer.Serialize(Model.DailySessions.Select(p => p.Total));
    var dailyCompletedJson = System.Text.Json.JsonSerializer.Serialize(Model.DailySessions.Select(p => p.Completed));
    var cancellationLabelsJson = System.Text.Json.JsonSerializer.Serialize(Model.TopCancellationReasons.Select(c => c.Label));
    var cancellationCountsJson = System.Text.Json.JsonSerializer.Serialize(Model.TopCancellationReasons.Select(c => c.Count));
    var statusTotal = Model.StatusDistribution.Sum(s => s.Count);
    var statusColorsJson = System.Text.Json.JsonSerializer.Serialize(Model.StatusDistribution.Select(s => s.Tone switch
    {
        "good" => "#3b82f6",
        "critical" => "#a855f7",
        _ => "#f472b6"
    }));
    var cancellationToneColors = new[] { "#dc2626", "#ea580c", "#d97706", "#ca8a04", "#0284c7" };
    var cancellationColorsJson = System.Text.Json.JsonSerializer.Serialize(cancellationToneColors);

    string StatusDotA(string tone) => tone switch
    {
        "good" => "#3b82f6",
        "critical" => "#a855f7",
        _ => "#f472b6"
    };
    string StatusDotB(string tone) => tone switch
    {
        "good" => "#2563eb",
        "critical" => "#7e22ce",
        _ => "#be185d"
    };

    string StatusLabel(SessionStatus status) => status switch
    {
        SessionStatus.Completed => "Completada",
        SessionStatus.Canceled => "Cancelada",
        _ => "Pendiente"
    };
}

<div class="kg-dashboard-hero mb-4">
    <div class="kg-dashboard-hero-copy">
        <div class="kg-dashboard-hero-kicker">
            <i class="bi bi-speedometer2"></i>
            Panel operativo
        </div>
        <h2>Tu centro de control para el día de trabajo</h2>
        <p>
            Aquí tienes el estado general del sistema, los indicadores que importan y los accesos rápidos
            para resolver la operación clínica sin navegar de más.
        </p>
        <div class="kg-dashboard-hero-actions">
            <a asp-controller="Sessions" asp-action="Index" asp-route-dateFrom="@todayIso" asp-route-dateTo="@todayIso" class="btn-kg-primary">
                <i class="bi bi-calendar2-week-fill"></i>
                Ver agenda de hoy
            </a>
            <a asp-controller="Home" asp-action="QuienesSomos" class="btn-kg-outline">
                <i class="bi bi-info-circle"></i>
                Conocer la plataforma
            </a>
        </div>
    </div>

    <div class="kg-dashboard-hero-meta">
        <div class="kg-dashboard-hero-chip">
            <i class="bi bi-calendar3"></i>
            <span>@todayDisplay</span>
        </div>
        <div class="kg-dashboard-hero-chip">
            <i class="bi bi-activity"></i>
            <span>Sesión protegida y auditada</span>
        </div>
        <div class="kg-dashboard-hero-chip">
            <i class="bi bi-shield-check"></i>
            <span>@User.Identity?.Name</span>
        </div>
        @if (isAdmin)
        {
            <form asp-controller="Home" asp-action="Index" method="post" class="kg-office-form" id="kgOfficeForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="officeId" id="kgOfficeValue" value="@(Model.SelectedOfficeId?.ToString() ?? "")" />
                <div class="kg-hero-dropdown" id="kgOfficeDropdown">
                    <button type="button"
                            class="kg-hero-select"
                            id="kgOfficeTrigger"
                            aria-haspopup="listbox"
                            aria-expanded="false"
                            aria-controls="kgOfficeList"
                            aria-label="Seleccionar sede">
                        <i class="bi bi-building-fill kg-hero-select-icon" aria-hidden="true"></i>
                        <span class="kg-hero-select-label" id="kgOfficeLabel">@selectedLabel</span>
                        <i class="bi bi-chevron-down kg-hero-select-caret" aria-hidden="true"></i>
                    </button>

                    <div class="kg-hero-menu" id="kgOfficeList" role="listbox" aria-label="Sedes disponibles" tabindex="-1">
                        <button type="button" class="kg-hero-option @(Model.SelectedOfficeId.HasValue ? "" : "is-selected")" role="option" aria-selected="@(Model.SelectedOfficeId.HasValue ? "false" : "true")" data-value="" data-label="Todas las sedes">
                            <i class="bi bi-buildings" aria-hidden="true"></i>
                            <span>Todas las sedes</span>
                            <i class="bi bi-check2 kg-hero-option-check" aria-hidden="true"></i>
                        </button>
                        @foreach (var office in offices)
                        {
                            var isSel = Model.SelectedOfficeId == office.Id;
                            <button type="button" class="kg-hero-option @(isSel ? "is-selected" : "")" role="option" aria-selected="@(isSel ? "true" : "false")" data-value="@office.Id" data-label="Oficina @office.Id - @office.Name">
                                <i class="bi bi-geo-alt" aria-hidden="true"></i>
                                <span>Oficina @office.Id - @office.Name</span>
                                <i class="bi bi-check2 kg-hero-option-check" aria-hidden="true"></i>
                            </button>
                        }
                    </div>
                </div>
            </form>
        }
    </div>
</div>

<!-- Page Header -->
<div class="kg-page-header">
    <div>
        <p class="text-muted mb-0">Resumen operativo del centro de kinesiología</p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <span class="kg-badge kg-badge-muted">@(Model.SelectedOfficeId.HasValue ? "Por sede" : "Global")</span>
        <span class="kg-badge kg-badge-success">
            <i class="bi bi-circle-fill kg-badge-dot"></i> Sistema activo
        </span>
        <span class="text-muted small">Actualizado @Model.GeneratedAtUtc.ToLocalTime().ToString("HH:mm:ss")</span>
    </div>
</div>

@if (Model.IsBillingOperationalAlertActive)
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center mb-3" role="alert">
        <div>
            <strong>Alerta operativa activa:</strong>
            Se detectaron 2 semanas consecutivas con baja efectividad de cobranzas.
            @if (Model.IsBillingOperationalAlertSentToday)
            {
                <span class="ms-2">Notificación administrativa enviada hoy.</span>
            }
            @if (Model.LastBillingOperationalAlertAtUtc.HasValue)
            {
                <span class="ms-2">último envío: @Model.LastBillingOperationalAlertAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.LastBillingOperationalAlertChangedBy))
            {
                <span class="ms-2">Disparado por: @Model.LastBillingOperationalAlertChangedBy</span>
            }
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Billing" asp-action="Index" class="btn btn-sm btn-outline-danger">Ir a Cobranzas</a>
            <a asp-controller="Reminders" asp-action="Index" class="btn btn-sm btn-outline-secondary">Ir a Recordatorios</a>
            @if (isAdmin)
            {
                <form asp-controller="Home" asp-action="TriggerBillingOperationalAlert" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger">Reintentar alerta</button>
                </form>
            }
        </div>
    </div>

    @if (Model.RecentBillingOperationalAlerts.Count > 0)
    {
        <div class="alert alert-light border mb-3" role="status">
            <strong>últimas alertas operativas:</strong>
            <ul class="mb-0 mt-2">
                @foreach (var item in Model.RecentBillingOperationalAlerts)
                {
                    <li class="d-flex flex-wrap align-items-center gap-2">
                        <span>
                            @item.ChangedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm") -
                            <span class="fw-semibold @(item.IsSystemTriggered ? "text-secondary" : "text-primary")">
                                @item.ChangedBy
                            </span>
                        </span>
                        <span class="badge kg-alert-origin-badge @(item.IsSystemTriggered ? "text-bg-secondary" : "text-bg-primary")"
                            tabindex="0"
                            title="@((item.IsSystemTriggered ? "Origen automático por sistema" : "Origen manual disparado por usuario"))"
                            aria-label="@($"Origen de alerta: {item.TriggerSourceLabel}. {(item.IsSystemTriggered ? "Disparo automático por sistema" : "Disparo manual por usuario")}")">
                            @item.TriggerSourceLabel
                        </span>
                    </li>
                }
            </ul>
        </div>
    }
}

<!-- Agenda del día + distribución -->
<div class="row g-4 mb-5">
    <div class="col-lg-7">
        <div class="kg-card h-100">
            <div class="kg-card-header">
                <h5 class="kg-card-header-title"><i class="bi bi-calendar2-week-fill"></i> Agenda de hoy</h5>
                <a asp-controller="Sessions" asp-action="Index" asp-route-dateFrom="@todayIso" asp-route-dateTo="@todayIso" class="kg-badge kg-badge-muted kg-link-plain">Ver agenda completa</a>
            </div>
            <div class="kg-card-body">
                @if (Model.TodayAgenda.Count == 0)
                {
                    <p class="text-muted mb-0">No hay sesiones agendadas para hoy@(Model.SelectedOfficeId.HasValue ? " en esta sede" : "").</p>
                }
                else
                {
                    <ul class="kg-agenda-list list-unstyled mb-0">
                        @foreach (var item in Model.TodayAgenda)
                        {
                            <li class="kg-agenda-item">
                                <span class="kg-agenda-time">@item.FechaHora.ToLocalTime().ToString("HH:mm")</span>
                                <div class="kg-agenda-main">
                                    <div class="fw-semibold">@item.PacienteNombre</div>
                                    <small class="text-muted">@item.ProfesionalNombre@(string.IsNullOrWhiteSpace(item.OfficeNombre) ? "" : $" · {item.OfficeNombre}")</small>
                                </div>
                                <span class="kg-badge @(item.Status == SessionStatus.Completed ? "kg-badge-info" : item.Status == SessionStatus.Canceled ? "kg-badge-muted" : "kg-badge-primary")">@StatusLabel(item.Status)</span>
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="Sessions" asp-action="Details" asp-route-id="@item.SessionId" title="Ver sesión" aria-label="Ver sesión de @item.PacienteNombre">
                                    <i class="bi bi-arrow-right-short"></i>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="kg-billing-panel h-100">
            <div class="kg-billing-header">
                <h5 class="kg-billing-title">Distribución por estado</h5>
                <div class="kg-billing-subtitle">Análisis de sesiones · Últimos 30 días</div>
            </div>
            <div class="kg-billing-body">
                <div class="kg-billing-chart-wrap">
                    <canvas id="homeStatusChart" role="img"
                            aria-label="Distribución de sesiones por estado en los últimos 30 días: @string.Join(", ", Model.StatusDistribution.Select(s => s.Count + " " + s.Label.ToLowerInvariant()))"></canvas>
                    <div class="kg-billing-center">
                        <div class="kg-billing-total">@statusTotal</div>
                        <div class="kg-billing-subtotal-center">SESIONES</div>
                        <div class="kg-billing-updated">Actualizado @Model.GeneratedAtUtc.ToLocalTime().ToString("HH:mm")</div>
                    </div>
                </div>
                <ul class="kg-billing-legend">
                    @foreach (var item in Model.StatusDistribution)
                    {
                        var itemPct = statusTotal > 0 ? Math.Round((decimal)item.Count * 100m / statusTotal, 1) : 0m;
                        <li class="kg-billing-legend-item">
                            <span class="kg-billing-dot" aria-hidden="true" style="--dot-a: @StatusDotA(item.Tone); --dot-b: @StatusDotB(item.Tone);"></span>
                            <span class="kg-billing-label">@item.Label</span>
                            <span class="kg-billing-value">@item.Count</span>
                            <span class="kg-billing-pct">@itemPct.ToString("0.#")%</span>
                        </li>
                    }
                </ul>
                <details class="kg-chart-data">
                    <summary>Ver datos de la distribución</summary>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Estado</th>
                                    <th class="text-end">Sesiones</th>
                                    <th class="text-end">%</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.StatusDistribution.Count == 0)
                                {
                                    <tr><td colspan="3" class="text-muted">Sin datos en el período.</td></tr>
                                }
                                else
                                {
                                    @foreach (var item in Model.StatusDistribution)
                                    {
                                        var itemPctRow = statusTotal > 0 ? Math.Round((decimal)item.Count * 100m / statusTotal, 1) : 0m;
                                        <tr>
                                            <td>@item.Label</td>
                                            <td class="text-end">@item.Count</td>
                                            <td class="text-end">@itemPctRow.ToString("0.#")%</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            </div>
        </div>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-4 mb-5">
    <div class="col-sm-6 col-xl-3">
        <div class="kg-stat-card kg-stat-card-elevated">
            <div class="kg-stat-icon blue"><i class="bi bi-people-fill"></i></div>
            <div>
                <div class="kg-stat-label fw-semibold text-uppercase small">Pacientes activos <span class="kg-badge kg-badge-muted">Global</span></div>
                <div class="kg-stat-value @(Model.PacientesActivosCount == 0 ? "is-empty" : "")">@Model.PacientesActivosCount</div>
                @if (Model.PacientesActivosCount == 0)
                {
                    <div class="kg-stat-empty">Sin pacientes registrados</div>
                }
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kg-stat-card kg-stat-card-elevated">
            <div class="kg-stat-icon cyan"><i class="bi bi-person-badge-fill"></i></div>
            <div>
                <div class="kg-stat-label fw-semibold text-uppercase small">Profesionales <span class="kg-badge kg-badge-muted">Global</span></div>
                <div class="kg-stat-value @(Model.ProfesionalesActivosCount == 0 ? "is-empty" : "")">@Model.ProfesionalesActivosCount</div>
                @if (Model.ProfesionalesActivosCount == 0)
                {
                    <div class="kg-stat-empty">Sin profesionales activos</div>
                }
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kg-stat-card kg-stat-card-elevated">
            <div class="kg-stat-icon green"><i class="bi bi-journal-medical"></i></div>
            <div>
                <div class="kg-stat-label fw-semibold text-uppercase small">Tratamientos <span class="kg-badge kg-badge-muted">Global</span></div>
                <div class="kg-stat-value @(Model.TratamientosCount == 0 ? "is-empty" : "")">@Model.TratamientosCount</div>
                @if (Model.TratamientosCount == 0)
                {
                    <div class="kg-stat-empty">Sin planes terapéuticos cargados</div>
                }
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kg-stat-card kg-stat-card-elevated">
            <div class="kg-stat-icon violet"><i class="bi bi-calendar2-check-fill"></i></div>
            <div>
                <div class="kg-stat-label fw-semibold text-uppercase small">Sesiones <span class="kg-badge @(Model.SelectedOfficeId.HasValue ? "kg-badge-info" : "kg-badge-muted")">@(Model.SelectedOfficeId.HasValue ? "Por sede" : "Global")</span></div>
                <div class="kg-stat-value @(Model.SesionesCount == 0 ? "is-empty" : "")">@Model.SesionesCount</div>
                @if (Model.SesionesCount == 0)
                {
                    <div class="kg-stat-empty">Sin sesiones registradas</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Operational Cards -->
<div class="row g-4 mb-5">
    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Sessions" asp-action="Index" asp-route-dateFrom="@todayIso" asp-route-dateTo="@todayIso" class="kg-stat-card kg-stat-link text-decoration-none">
            <div class="kg-stat-icon orange">
                <i class="bi bi-calendar2-day-fill"></i>
                <div class="position-absolute bottom-0 end-0 p-2">
                    <small class="text-uppercase fw-bold small opacity-80">Hoy</small>
                </div>
            </div>
            <div>
                <div class="kg-stat-label fw-semibold text-uppercase small">Sesiones hoy</div>
                <div class="kg-stat-value @(Model.SesionesHoyCount == 0 ? "is-empty" : "")">@Model.SesionesHoyCount</div>
                @if (Model.SesionesHoyCount == 0)
                {
                    <div class="kg-stat-empty">No hay sesiones agendadas para hoy</div>
                }
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Sessions" asp-action="Index" asp-route-status="Completed" asp-route-dateFrom="@todayIso" asp-route-dateTo="@todayIso" class="kg-stat-card kg-stat-link text-decoration-none">
            <div class="kg-stat-icon green">
                <i class="bi bi-check2-circle"></i>
                <div class="position-absolute bottom-0 end-0 p-2">
                    <small class="text-uppercase fw-bold small opacity-80">Hoy</small>
                </div>
            </div>
            <div>
                <div class="kg-stat-label fw-semibold text-uppercase small">Completadas hoy</div>
                <div class="kg-stat-value @(Model.SesionesCompletadasHoyCount == 0 ? "is-empty" : "")">@Model.SesionesCompletadasHoyCount</div>
                @if (Model.SesionesCompletadasHoyCount == 0)
                {
                    <div class="kg-stat-empty">Nada completado todavía</div>
                }
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Billing" asp-action="Index" asp-route-onlyCompletedPending="true" class="kg-stat-card kg-stat-link text-decoration-none">
            <div class="kg-stat-icon red">
                <i class="bi bi-credit-card-fill"></i>
                <div class="position-absolute bottom-0 end-0 p-2">
                    <small class="text-uppercase fw-bold small opacity-80">30d</small>
                </div>
            </div>
            <div>
                <div class="kg-stat-label fw-semibold text-uppercase small">Completadas sin cobrar</div>
                <div class="kg-stat-value @(Model.SesionesPendientesPagoCount == 0 ? "is-empty" : "")">@Model.SesionesPendientesPagoCount</div>
                @if (Model.SesionesPendientesPagoCount == 0)
                {
                    <div class="kg-stat-empty">Sin cobros pendientes</div>
                }
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Sessions" asp-action="Index" asp-route-status="Pending" class="kg-stat-card kg-stat-link text-decoration-none">
            <div class="kg-stat-icon yellow">
                <i class="bi bi-hourglass-split"></i>
                <div class="position-absolute bottom-0 end-0 p-2">
                    <small class="text-uppercase fw-bold small opacity-80">Hoy</small>
                </div>
            </div>
            <div>
                <div class="kg-stat-label fw-semibold text-uppercase small">Sin confirmar</div>
                <div class="kg-stat-value @(Model.SesionesPendientesConfirmacionCount == 0 ? "is-empty" : "")">@Model.SesionesPendientesConfirmacionCount</div>
                @if (Model.SesionesPendientesConfirmacionCount == 0)
                {
                    <div class="kg-stat-empty">Todas las sesiones están confirmadas</div>
                }
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Sessions" asp-action="Index" asp-route-status="Canceled" asp-route-dateFrom="@todayIso" asp-route-dateTo="@todayIso" class="kg-stat-card kg-stat-link text-decoration-none">
            <div class="kg-stat-icon orange">
                <i class="bi bi-x-circle-fill"></i>
                <div class="position-absolute bottom-0 end-0 p-2">
                    <small class="text-uppercase fw-bold small opacity-80">Hoy</small>
                </div>
            </div>
            <div>
                <div class="kg-stat-label fw-semibold text-uppercase small">Canceladas hoy</div>
                <div class="kg-stat-value @(Model.SesionesCanceladasHoyCount == 0 ? "is-empty" : "")">@Model.SesionesCanceladasHoyCount</div>
                @if (Model.SesionesCanceladasHoyCount == 0)
                {
                    <div class="kg-stat-empty">Sin cancelaciones hoy</div>
                }
            </div>
        </a>
    </div>
</div>

<!-- Rendimiento 30 días -->
<div class="row g-4 mb-5">
    <div class="col-sm-6 col-xl-4">
        <div class="kg-stat-card kg-stat-card-elevated">
            <div class="kg-stat-icon green"><i class="bi bi-graph-up-arrow"></i></div>
            <div>
                <div class="kg-stat-label fw-semibold text-uppercase small">Cumplimiento hoy</div>
                <div class="kg-stat-value @(Model.CompletionRateToday == 0 ? "is-empty" : "")" title="Completadas hoy ÷ sesiones de hoy">@Model.CompletionRateToday.ToString("N2")%</div>
                <small class="text-muted opacity-75">Completadas sobre sesiones del día</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <a asp-controller="Billing" asp-action="Index" class="kg-stat-card kg-stat-link text-decoration-none">
            <div class="kg-stat-icon cyan">
                <i class="bi bi-cash-stack"></i>
                <div class="position-absolute bottom-0 end-0 p-2">
                    <small class="text-uppercase fw-bold small opacity-80">30d</small>
                </div>
            </div>
            <div>
                <div class="kg-stat-label fw-semibold text-uppercase small">Tasa de cobranza</div>
                <div class="kg-stat-value @(Model.CollectionRateLast30Days == 0 ? "is-empty" : "")" title="Completadas pagadas ÷ completadas (30 días)">@Model.CollectionRateLast30Days.ToString("N2")%</div>
                <small class="text-muted opacity-75">Completadas pagadas sobre completadas</small>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-4">
        <a asp-controller="Sessions" asp-action="Index" asp-route-status="Canceled" asp-route-dateFrom="@last30StartIso" asp-route-dateTo="@todayIso" class="kg-stat-card kg-stat-link text-decoration-none">
            <div class="kg-stat-icon orange">
                <i class="bi bi-exclamation-circle"></i>
                <div class="position-absolute bottom-0 end-0 p-2">
                    <small class="text-uppercase fw-bold small opacity-80">30d</small>
                </div>
            </div>
            <div>
