@model KineGestion.Web.Models.ViewModels.EquipmentIndexViewModel

@{
    ViewData["Title"] = "Equipamiento";
}

<div class="kg-page-header">
    <div>
        <h2>Equipamiento</h2>
        <p class="text-muted mb-0">Gestión de los equipos del centro</p>
    </div>
    <a asp-action="Create" class="btn-kg-primary">
        <i class="bi bi-plus-circle"></i> Nuevo Equipo
    </a>
</div>

<div class="kg-card">
    <div class="kg-card-header">
        <h5 class="kg-card-header-title">
            <i class="bi bi-tools"></i> Listado de Equipamiento
        </h5>
        <span class="kg-badge kg-badge-muted">@Model.TotalCount registros</span>
    </div>

    <form method="get" class="px-3 pt-3 pb-1">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted">Buscar</label>
                <input name="search" value="@Model.Search" class="form-control" placeholder="Nombre del equipo" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">Consultorio</label>
                <select name="officeId" class="form-select">
                    <option value="" selected="@(Model.OfficeId == null)">Todos los consultorios</option>
                    @foreach (var office in Model.Offices)
                    {
                        <option value="@office.Value" selected="@office.Selected">@office.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn-kg-primary w-100"><i class="bi bi-search"></i></button>
                <a asp-action="Index" class="btn-kg-outline w-100"><i class="bi bi-x-lg"></i></a>
            </div>
        </div>
    </form>

    @if (!Model.Items.Any())
    {
        <div class="kg-empty">
            <div class="kg-empty-icon"><i class="bi bi-tools"></i></div>
            <h5>Sin equipamiento registrado</h5>
            <p>Cargá los equipos disponibles del centro kinesiológico.</p>
            <a asp-action="Create" class="btn-kg-primary">
                <i class="bi bi-plus-circle"></i> Cargar el primero
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="kg-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Consultorio</th>
                        <th style="text-align:right">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Items)
                    {
                        <tr>
                            <td>
                                <div style="display:flex;align-items:center;gap:10px">
                                    <div style="width:34px;height:34px;border-radius:8px;background:#eff6ff;color:#2563eb;display:flex;align-items:center;justify-content:center;font-size:1rem;flex-shrink:0">
                                        <i class="bi bi-tools"></i>
                                    </div>
                                    <span style="font-weight:600">@e.Name</span>
                                </div>
                            </td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(e.OfficeName))
                                {
                                    <span class="kg-badge kg-badge-muted"><i class="bi bi-dash-circle"></i> Sin asignar</span>
                                }
                                else
                                {
                                    <span>@e.OfficeName</span>
                                }
                            </td>
                            <td style="text-align:right">
                                <div style="display:flex;gap:6px;justify-content:flex-end">
                                    <a asp-action="Details" asp-route-id="@e.Id" class="kg-action-btn view" title="Ver detalle"><i class="bi bi-eye-fill"></i></a>
                                    <a asp-action="Edit" asp-route-id="@e.Id" class="kg-action-btn edit" title="Editar"><i class="bi bi-pencil-fill"></i></a>
                                    <a asp-action="Delete" asp-route-id="@e.Id" class="kg-action-btn del" title="Eliminar"><i class="bi bi-trash-fill"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div style="padding:12px 18px;border-top:1px solid var(--kg-border);font-size:.76rem;color:var(--kg-text-muted)">
            Mostrando @Model.Items.Count() de @Model.TotalCount equipos
        </div>

        @if (Model.TotalPages > 1)
        {
            <div style="padding:12px 18px;border-top:1px solid var(--kg-border);display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap">
                <span style="font-size:.78rem;color:var(--kg-text-muted)">Página @Model.Page de @Model.TotalPages</span>
                <div style="display:flex;gap:6px">
                    <a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search" asp-route-officeId="@Model.OfficeId" class="btn-kg-outline @(Model.Page <= 1 ? "disabled" : "")">Anterior</a>
                    <a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search" asp-route-officeId="@Model.OfficeId" class="btn-kg-outline @(Model.Page >= Model.TotalPages ? "disabled" : "")">Siguiente</a>
                </div>
            </div>
        }
    }
</div>
