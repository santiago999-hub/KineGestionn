@using System.Globalization
@using KineGestion.Core
@model KineGestion.Web.Models.ViewModels.BillingDashboardViewModel

@{
    ViewData["Title"] = "Cobranzas";
    var totalCountAll = Model.PendingCount + Model.PaidCount + Model.CompletedPendingCount;
    var pendingPct = totalCountAll > 0 ? Math.Round((decimal)Model.PendingCount * 100m / totalCountAll, 1) : 0m;
    var paidPct = totalCountAll > 0 ? Math.Round((decimal)Model.PaidCount * 100m / totalCountAll, 1) : 0m;
    var compPendPct = totalCountAll > 0 ? Math.Round((decimal)Model.CompletedPendingCount * 100m / totalCountAll, 1) : 0m;
    var variation = Model.CollectedVariationPct;
    var variationText = variation.HasValue
        ? (variation.Value >= 0 ? "+" : "") + variation.Value.ToString("0.#", CultureInfo.InvariantCulture) + "%"
        : "sin base previa";
    var variationClass = !variation.HasValue ? "kg-badge-muted" : (variation.Value >= 0 ? "kg-badge-success" : "kg-badge-danger");
    var effectivenessWidth = Math.Clamp(Model.CollectionEffectivenessPct, 0m, 100m).ToString("0.#", CultureInfo.InvariantCulture);
    var rangeLabel = $"{Model.DateFrom:dd/MM/yyyy} al {Model.DateTo:dd/MM/yyyy}";
    var dailyLabels = string.Join(",", Model.DailyPoints.Select(p => "'" + p.Label + "'"));
    var dailyAmounts = string.Join(",", Model.DailyPoints.Select(p => p.CollectedAmount.ToString("0.##", CultureInfo.InvariantCulture)));
    var dailyCounts = string.Join(",", Model.DailyPoints.Select(p => p.PaidCount));
    var trendLabels = string.Join(",", Model.WeeklyTrendPoints.Select(p => "'" + p.Label + "'"));
    var trendValues = string.Join(",", Model.WeeklyTrendPoints.Select(p => p.EffectivenessPct.ToString("0.00", CultureInfo.InvariantCulture)));
    var exportRoute = new
    {
        dateFrom = Model.DateFrom.ToString("yyyy-MM-dd"),
        dateTo = Model.DateTo.ToString("yyyy-MM-dd"),
        search = Model.Search,
        onlyCompletedPending = Model.OnlyCompletedPending,
        status = Model.StatusFilter,
        payment = Model.PaymentFilter,
        filtersApplied = Model.FiltersApplied
    };
}

<div class="kg-page-header">
    <div>
        <h2><i class="bi bi-cash-stack"></i> Cobranzas</h2>
        <p class="text-muted mb-0">Seguimiento de pagos, aging y efectividad · @rangeLabel (@Model.RangeDays días)</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-sm btn-outline-secondary"
           href="@Url.Action("Index", "Audit", new { entityName = "BillingBatch", action = "Create", dateFrom = Model.WeeklyBatchFrom.ToString("yyyy-MM-dd"), dateTo = Model.WeeklyBatchTo.ToString("yyyy-MM-dd") })">
            <i class="bi bi-clock-history"></i> Auditoría de lotes
        </a>
        <a class="btn btn-sm btn-outline-primary" href="@Url.Action("ExportCsv", exportRoute)">
            <i class="bi bi-download"></i> Exportar CSV
        </a>
    </div>
</div>

@if (Model.LastBatchRequestedCount.HasValue)
{
    <div class="alert alert-info d-flex align-items-center gap-3 mb-3" role="status">
        <i class="bi bi-info-circle-fill fs-5"></i>
        <div>
            <strong>Último lote procesado:</strong>
            Solicitadas <strong>@Model.LastBatchRequestedCount</strong> ·
            Actualizadas <strong>@Model.LastBatchUpdatedCount</strong> ·
            Omitidas <strong>@Model.LastBatchSkippedCount</strong> ·
            Efectividad <strong>@Model.LastBatchEffectivenessPct?.ToString("N2")%</strong>
        </div>
    </div>
}

<h6 class="text-uppercase text-muted fw-semibold mb-2 mt-4" style="letter-spacing: .05em;"><i class="bi bi-grid-fill"></i> Resumen del período</h6>
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="kg-stat-card">
            <div class="kg-stat-icon green"><i class="bi bi-cash-coin"></i></div>
            <div>
                <div class="kg-stat-label">Cobrado (estimado)</div>
                <div class="kg-stat-value">$ @Model.PaidAmount.ToString("N2")</div>
                <span class="kg-badge @variationClass mt-1">@variationText vs período anterior</span>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kg-stat-card">
            <div class="kg-stat-icon orange"><i class="bi bi-exclamation-triangle-fill"></i></div>
            <div>
                <div class="kg-stat-label">A cobrar (completadas)</div>
                <div class="kg-stat-value">$ @Model.CompletedPendingAmount.ToString("N2")</div>
                <small class="text-muted">@Model.CompletedPendingCount sesiones sin cobrar</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kg-stat-card">
            <div class="kg-stat-icon cyan"><i class="bi bi-speedometer2"></i></div>
            <div>
                <div class="kg-stat-label">Efectividad de cobro</div>
                <div class="kg-stat-value">@Model.CollectionEffectivenessPct.ToString("0.#", CultureInfo.InvariantCulture)%</div>
                <div class="progress mt-1" style="height: 6px;">
                    <div class="progress-bar" role="progressbar" style="width: @(effectivenessWidth)%;" aria-valuenow="@effectivenessWidth" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <small class="text-muted">@Model.CompletedPaidCount de @(Model.CompletedPaidCount + Model.CompletedPendingCount) completadas cobradas</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kg-stat-card">
            <div class="kg-stat-icon violet"><i class="bi bi-receipt"></i></div>
            <div>
                <div class="kg-stat-label">Sesiones del período</div>
                <div class="kg-stat-value">@(Model.PaidCount + Model.PendingCount)</div>
                <small class="text-muted">@Model.PaidCount pagadas · @Model.PendingCount pendientes</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="kg-card h-100">
            <div class="kg-card-header">
                <h5 class="kg-card-header-title"><i class="bi bi-graph-up-arrow"></i> Evolución de cobranza</h5>
                <div class="d-flex gap-1">
                    @foreach (var days in new[] { 7, 30, 90 })
                    {
                        var presetFrom = DateTime.UtcNow.Date.AddDays(-(days - 1)).ToString("yyyy-MM-dd");
                        var presetTo = DateTime.UtcNow.Date.ToString("yyyy-MM-dd");
                        var isActive = Model.RangeDays == days;
                        <a class="btn btn-sm @(isActive ? "btn-primary" : "btn-outline-secondary")"
                           href="@Url.Action("Index", new { dateFrom = presetFrom, dateTo = presetTo, search = Model.Search, pageSize = Model.PageSize, status = Model.StatusFilter, payment = Model.PaymentFilter, filtersApplied = true })">@days d</a>
                    }
                </div>
            </div>
            <div class="kg-card-body">
                <div class="kg-chart-frame">
                    <canvas id="billingEvolutionChart" role="img" aria-label="Evolución diaria del monto cobrado"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="kg-card h-100">
            <div class="kg-card-header">
                <h5 class="kg-card-header-title"><i class="bi bi-donut"></i> Distribución por estado</h5>
                <span class="kg-chart-total"><strong>@totalCountAll</strong> sesiones</span>
            </div>
            <div class="kg-card-body">
                <div class="kg-chart-frame">
                    <canvas id="billingStatusChart" role="img"
                            aria-label="Distribución por estado: @Model.CompletedPendingCount completadas sin cobrar, @Model.PendingCount pendientes y @Model.PaidCount pagadas"></canvas>
                </div>
                <ul class="kg-chart-legend">
                    <li class="kg-chart-legend-item is-warn">
                        <span class="kg-chart-dot is-warn" aria-hidden="true"></span>
                        <span class="kg-chart-legend-label">Completadas sin cobrar</span>
                        <span class="kg-chart-legend-value">@Model.CompletedPendingCount</span>
                        <span class="kg-chart-legend-pct">@compPendPct.ToString("0.#")%</span>
                    </li>
                    <li class="kg-chart-legend-item is-critical">
                        <span class="kg-chart-dot is-critical" aria-hidden="true"></span>
                        <span class="kg-chart-legend-label">Pendientes</span>
                        <span class="kg-chart-legend-value">@Model.PendingCount</span>
                        <span class="kg-chart-legend-pct">@pendingPct.ToString("0.#")%</span>
                    </li>
                    <li class="kg-chart-legend-item is-good">
                        <span class="kg-chart-dot is-good" aria-hidden="true"></span>
                        <span class="kg-chart-legend-label">Pagadas</span>
                        <span class="kg-chart-legend-value">@Model.PaidCount</span>
                        <span class="kg-chart-legend-pct">@paidPct.ToString("0.#")%</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="kg-card h-100">
            <div class="kg-card-header">
                <h5 class="kg-card-header-title"><i class="bi bi-hourglass-split"></i> Aging de cobranzas</h5>
            </div>
            <div class="kg-card-body">
                <div class="kg-chart-frame">
                    <canvas id="billingAgingChart" role="img" aria-label="Antigüedad de saldos pendientes"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="kg-card h-100">
            <div class="kg-card-header">
                <h5 class="kg-card-header-title"><i class="bi bi-bar-chart-line"></i> Efectividad semanal de lotes</h5>
                <span class="kg-badge @(Model.IsWeeklyBatchEffectivenessLow ? "kg-badge-warning" : "kg-badge-info")">
                    Umbral @Model.WeeklyBatchWarnThresholdPct.ToString("0.#")%
                </span>
            </div>
            <div class="kg-card-body">
                <div class="kg-chart-frame">
                    <canvas id="billingTrendChart" role="img" aria-label="Efectividad semanal de los lotes de cobranza"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="kg-card h-100">
            <div class="kg-card-header">
                <h5 class="kg-card-header-title"><i class="bi bi-person-check"></i> Efectividad por profesional</h5>
                <span class="text-muted small">@rangeLabel</span>
            </div>
            <div class="kg-card-body p-0">
                @if (Model.ProfessionalEffectiveness.Count == 0)
                {
                    <p class="text-muted p-3 mb-0">Sin sesiones completadas en el período.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Profesional</th>
                                    <th class="text-end">Completadas</th>
                                    <th class="text-end">Sin cobrar</th>
                                    <th class="text-end">A cobrar</th>
                                    <th style="min-width: 130px;">Efectividad</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var professional in Model.ProfessionalEffectiveness)
                                {
                                    var width = Math.Clamp(professional.CollectionPct, 0m, 100m).ToString("0.#", CultureInfo.InvariantCulture);
                                    <tr>
                                        <td class="fw-semibold">@professional.ProfessionalName</td>
                                        <td class="text-end">@professional.Completed</td>
                                        <td class="text-end">@professional.CompletedPending</td>
                                        <td class="text-end">$ @professional.PendingAmount.ToString("N2")</td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="progress flex-grow-1" style="height: 6px;">
                                                    <div class="progress-bar" role="progressbar" style="width: @(width)%;" aria-valuenow="@width" aria-valuemin="0" aria-valuemax="100"></div>
                                                </div>
                                                <small class="text-muted">@professional.CollectionPct.ToString("0.#", CultureInfo.InvariantCulture)%</small>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="kg-card h-100">
            <div class="kg-card-header">
                <h5 class="kg-card-header-title"><i class="bi bi-person-exclamation"></i> Top deudas por paciente</h5>
                <span class="text-muted small">@rangeLabel</span>
            </div>
            <div class="kg-card-body p-0">
                @if (Model.TopPendingPatients.Count == 0)
                {
                    <p class="text-muted p-3 mb-0">Sin deudas pendientes en el período.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Paciente</th>
                                    <th class="text-end">Sesiones</th>
                                    <th class="text-end">Deuda</th>
                                    <th class="text-end">Antigüedad</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var debt in Model.TopPendingPatients)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@debt.PatientLabel</div>
                                            @if (!string.IsNullOrWhiteSpace(debt.Telefono))
                                            {
                                                <small class="text-muted"><i class="bi bi-telephone"></i> @debt.Telefono</small>
                                            }
                                        </td>
                                        <td class="text-end">@debt.PendingCount</td>
                                        <td class="text-end">$ @debt.PendingAmount.ToString("N2")</td>
                                        <td class="text-end">
                                            <span class="kg-badge @(debt.AgeDays >= 8 ? "kg-badge-danger" : debt.AgeDays >= 3 ? "kg-badge-warning" : "kg-badge-info")">
                                                @debt.AgeDays d
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.IsWeeklyBatchEffectivenessLow)
{
    <div class="alert alert-warning d-flex align-items-center gap-2 mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <div>
            <strong>Alerta operativa:</strong>
            Efectividad semanal @Model.WeeklyBatchEffectivenessPct?.ToString("N2")% por debajo del umbral @Model.WeeklyBatchWarnThresholdPct.ToString("N2")%
        </div>
    </div>
}

@if (Model.HasTwoConsecutiveLowWeeks)
{
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-3" role="alert">
        <i class="bi bi-shield-exclamation"></i>
        <div>
            <strong>Alerta crítica:</strong>
            2 semanas consecutivas por debajo del umbral (@Model.WeeklyBatchWarnThresholdPct.ToString("N2")%)
        </div>
    </div>
}

<div class="kg-card mb-4">
    <div class="kg-card-header">
        <h5 class="kg-card-header-title"><i class="bi bi-funnel-fill"></i> Filtros avanzados</h5>
        <span class="text-muted small">@Model.TotalCount resultado(s)</span>
    </div>
    <div class="kg-card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <input type="hidden" name="filtersApplied" value="true" />
            <div class="col-md-2">
                <label class="form-label">Desde</label>
                <input type="date" name="dateFrom" class="form-control" value="@Model.DateFrom.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Hasta</label>
                <input type="date" name="dateTo" class="form-control" value="@Model.DateTo.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Buscar</label>
                <input type="text" name="search" class="form-control" value="@Model.Search" placeholder="Paciente, profesional o tratamiento..." />
            </div>
            <div class="col-md-2">
                <label class="form-label">Estado de sesión</label>
                <select name="status" class="form-select">
                    <option value="" selected="@(Model.StatusFilter is null)">Todas</option>
                    <option value="Completed" selected="@(Model.StatusFilter == SessionStatus.Completed)">Completadas</option>
                    <option value="Pending" selected="@(Model.StatusFilter == SessionStatus.Pending)">Pendientes</option>
                    <option value="Canceled" selected="@(Model.StatusFilter == SessionStatus.Canceled)">Canceladas</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Estado de pago</label>
                <select name="payment" class="form-select">
                    <option value="" selected="@(Model.PaymentFilter is null)">Todos</option>
                    <option value="Pending" selected="@(Model.PaymentFilter == PaymentStatus.Pending)">Pendientes</option>
                    <option value="Paid" selected="@(Model.PaymentFilter == PaymentStatus.Paid)">Pagadas</option>
                </select>
            </div>
            <div class="col-md-1">
                <label class="form-label">Filas</label>
                <select name="pageSize" class="form-select">
                    @foreach (var size in new[] { 10, 25, 50 })
                    {
                        <option value="@size" selected="@(Model.PageSize == size)">@size</option>
                    }
                </select>
            </div>
            <div class="col-12 d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Aplicar filtros</button>
                <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-counterclockwise"></i> Limpiar</a>
                <a class="btn btn-outline-primary ms-auto" href="@Url.Action("ExportCsv", exportRoute)"><i class="bi bi-download"></i> Exportar resultados</a>
            </div>
        </form>
    </div>
</div>

<div class="kg-card">
    <div class="kg-card-header">
        <h5 class="kg-card-header-title"><i class="bi bi-list-check"></i> Movimientos de cobranza</h5>
        <span class="text-muted small">Importe calculado con valor de sesión $ @Model.DefaultSessionAmount.ToString("N2")</span>
    </div>
    <div class="kg-card-body">
        <form asp-action="MarkPaidBatch" method="post" id="batchMarkPaidForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="dateFrom" value="@Model.DateFrom.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="dateTo" value="@Model.DateTo.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="search" value="@Model.Search" />
            <input type="hidden" name="onlyCompletedPending" value="@Model.OnlyCompletedPending" />
            <input type="hidden" name="page" value="@Model.Page" />
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <input type="hidden" name="status" value="@Model.StatusFilter" />
            <input type="hidden" name="payment" value="@Model.PaymentFilter" />
            <input type="hidden" name="filtersApplied" value="@Model.FiltersApplied" />

            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <small class="text-muted">Seleccioná sesiones para acciones masivas</small>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-success" id="markSelectedPaidBtn" disabled>
                        <i class="bi bi-check2-all"></i> Marcar pagadas
                    </button>
                    <button type="submit" formaction="@Url.Action("MarkPendingBatch", "Billing")" class="btn btn-sm btn-outline-warning" id="markSelectedPendingBtn" disabled>
                        <i class="bi bi-arrow-counterclockwise"></i> Reabrir
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 40px;">
                                <input type="checkbox" id="selectAllSessions" class="form-check-input" />
                            </th>
                            <th>Fecha/Hora</th>
                            <th>Paciente</th>
                            <th>Profesional</th>
                            <th>Tratamiento</th>
                            <th class="text-center">Sesión</th>
                            <th class="text-center">Pago</th>
                            <th class="text-end">Importe</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">No hay movimientos para los filtros seleccionados.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr class="js-billing-row" data-payment-status="@(item.PaymentStatus == PaymentStatus.Paid ? "paid" : "pending")">
                                    <td>
                                        <input type="checkbox" class="form-check-input js-batch-session" name="sessionIds" value="@item.Id" />
                                    </td>
                                    <td><span class="fw-semibold">@item.FechaHora.ToString("dd/MM/yyyy")</span><br /><small class="text-muted">@item.FechaHora.ToString("HH:mm")</small></td>
                                    <td>@item.PacienteNombre</td>
                                    <td>@item.ProfesionalNombre</td>
                                    <td>@item.TratamientoDescripcion</td>
                                    <td class="text-center">
                                        @if (item.Status == SessionStatus.Completed)
                                        {
                                            <span class="kg-badge kg-badge-info">Completada</span>
                                        }
                                        else if (item.Status == SessionStatus.Canceled)
                                        {
                                            <span class="kg-badge kg-badge-muted">Cancelada</span>
                                        }
                                        else
                                        {
                                            <span class="kg-badge kg-badge-primary">Pendiente</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.PaymentStatus == PaymentStatus.Paid)
                                        {
                                            <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">Pagada</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Pendiente</span>
                                        }
                                    </td>
                                    <td class="text-end">$ @Model.DefaultSessionAmount.ToString("N2")</td>
                                    <td class="text-end">
                                        @if (item.PaymentStatus == PaymentStatus.Paid)
                                        {
                                            <form asp-action="MarkPending" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="sessionId" value="@item.Id" />
                                                <input type="hidden" name="dateFrom" value="@Model.DateFrom.ToString("yyyy-MM-dd")" />
                                                <input type="hidden" name="dateTo" value="@Model.DateTo.ToString("yyyy-MM-dd")" />
                                                <input type="hidden" name="search" value="@Model.Search" />
                                                <input type="hidden" name="onlyCompletedPending" value="@Model.OnlyCompletedPending" />
                                                <input type="hidden" name="page" value="@Model.Page" />
                                                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                                <input type="hidden" name="status" value="@Model.StatusFilter" />
                                                <input type="hidden" name="payment" value="@Model.PaymentFilter" />
                                                <input type="hidden" name="filtersApplied" value="@Model.FiltersApplied" />
                                                <button class="btn btn-sm btn-outline-secondary" type="submit"><i class="bi bi-arrow-counterclockwise"></i> Reabrir</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="MarkPaid" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="sessionId" value="@item.Id" />
                                                <input type="hidden" name="dateFrom" value="@Model.DateFrom.ToString("yyyy-MM-dd")" />
                                                <input type="hidden" name="dateTo" value="@Model.DateTo.ToString("yyyy-MM-dd")" />
                                                <input type="hidden" name="search" value="@Model.Search" />
                                                <input type="hidden" name="onlyCompletedPending" value="@Model.OnlyCompletedPending" />
                                                <input type="hidden" name="page" value="@Model.Page" />
                                                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                                <input type="hidden" name="status" value="@Model.StatusFilter" />
                                                <input type="hidden" name="payment" value="@Model.PaymentFilter" />
                                                <input type="hidden" name="filtersApplied" value="@Model.FiltersApplied" />
                                                <button class="btn btn-sm btn-success" type="submit"><i class="bi bi-check-lg"></i> Marcar pagada</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </form>

        @if (Model.TotalPages > 1)
        {
            <nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Paginación de cobranzas">
                <small class="text-muted">Página @Model.Page de @Model.TotalPages · @Model.TotalCount registros</small>
                <div class="btn-group btn-group-sm">
                    <a class="btn btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")"
                       href="@Url.Action("Index", new { dateFrom = Model.DateFrom.ToString("yyyy-MM-dd"), dateTo = Model.DateTo.ToString("yyyy-MM-dd"), search = Model.Search, onlyCompletedPending = Model.OnlyCompletedPending, page = Math.Max(1, Model.Page - 1), pageSize = Model.PageSize, status = Model.StatusFilter, payment = Model.PaymentFilter, filtersApplied = Model.FiltersApplied })">
                        <i class="bi bi-chevron-left"></i> Anterior
                    </a>
                    <a class="btn btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")"
                       href="@Url.Action("Index", new { dateFrom = Model.DateFrom.ToString("yyyy-MM-dd"), dateTo = Model.DateTo.ToString("yyyy-MM-dd"), search = Model.Search, onlyCompletedPending = Model.OnlyCompletedPending, page = Math.Min(Model.TotalPages, Model.Page + 1), pageSize = Model.PageSize, status = Model.StatusFilter, payment = Model.PaymentFilter, filtersApplied = Model.FiltersApplied })">
                        Siguiente <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </nav>
        }
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/kg-chart.js" asp-append-version="true"></script>
    <script>
        (() => {
            const statusCanvas = document.getElementById('billingStatusChart');
            if (statusCanvas && window.kgChart) {
                const labels = ['Completadas sin cobrar', 'Pendientes', 'Pagadas'];
                const values = [@Model.CompletedPendingCount, @Model.PendingCount, @Model.PaidCount];
                const total = values.reduce((sum, value) => sum + value, 0);

                window.kgChart.render('billingStatusChart', (palette) => {
                    const isDark = window.kgChart.isDark();
                    return {
                        type: 'doughnut',
                        data: {
                            labels,
                            datasets: [{
                                data: values,
                                backgroundColor: [palette.amber, palette.red, palette.green],
                                borderWidth: 0,
                                borderRadius: 10,
                                spacing: 4,
                                hoverOffset: 6
                            }]
                        },
                        options: {
                            cutout: '70%',
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    backgroundColor: isDark ? 'rgba(9, 20, 34, 0.96)' : 'rgba(255, 255, 255, 0.98)',
                                    titleColor: palette.text,
                                    bodyColor: palette.muted,
                                    borderColor: palette.grid,
                                    borderWidth: 1,
                                    padding: 10,
                                    callbacks: {
                                        label: (context) => {
                                            const pct = total > 0 ? (values[context.dataIndex] * 100 / total).toFixed(1) : '0.0';
                                            return ' ' + context.parsed + ' sesiones · ' + pct + '%';
                                        }
                                    }
                                }
                            }
                        }
                    };
                });
            }

            window.kgChart?.render('billingEvolutionChart', (palette) => ({
                type: 'line',
                data: {
                    labels: [@Html.Raw(dailyLabels)],
                    datasets: [{
                        label: 'Cobrado',
                        data: [@Html.Raw(dailyAmounts)],
                        borderColor: palette.accent,
                        backgroundColor: window.kgChart.withAlpha(palette.accent, 0.14),
                        fill: true,
                        tension: 0.35,
                        borderWidth: 2,
                        pointRadius: 0,
                        pointHoverRadius: 4,
                        pointHoverBackgroundColor: palette.accent
                    }]
                },
                options: {
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: (context) => '$ ' + Number(context.parsed.y).toLocaleString('es-AR'),
                                afterLabel: (context) => 'Sesiones pagadas: ' + [@Html.Raw(dailyCounts)][context.dataIndex]
                            }
                        }
                    },
                    scales: {
                        x: { ticks: { maxTicksLimit: 12 } },
                        y: { ticks: { callback: (value) => '$ ' + (value / 1000).toLocaleString('es-AR') + 'k' } }
                    }
                }
            }));

            window.kgChart?.render('billingAgingChart', (palette) => ({
                type: 'bar',
                data: {
                    labels: ['0-2 días', '3-7 días', '+8 días'],
                    datasets: [{
                        label: 'Sesiones',
                        data: [@Model.Aging0To2DaysCount, @Model.Aging3To7DaysCount, @Model.Aging8PlusDaysCount],
                        backgroundColor: [palette.amber, palette.orange, palette.red],
                        borderRadius: 6
                    }]
                },
                options: { plugins: { legend: { display: false } } }
            }));

            window.kgChart?.render('billingTrendChart', (palette) => ({
                type: 'bar',
                data: {
                    labels: [@Html.Raw(trendLabels)],
                    datasets: [{
                        label: 'Efectividad %',
                        data: [@Html.Raw(trendValues)],
                        backgroundColor: palette.cyan,
                        borderRadius: 6
                    }]
                },
                options: {
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true, max: 100, ticks: { callback: (value) => value + '%' } } }
                }
            }));

            const selectAll = document.getElementById('selectAllSessions');
            const markPaidButton = document.getElementById('markSelectedPaidBtn');
            const markPendingButton = document.getElementById('markSelectedPendingBtn');
            const checkboxes = Array.from(document.querySelectorAll('.js-batch-session'));

            if (!selectAll || !markPaidButton || !markPendingButton || checkboxes.length === 0) return;

            const refreshBatchState = () => {
                const selectedCount = checkboxes.filter(cb => cb.checked).length;
                const disabled = selectedCount === 0;
                markPaidButton.disabled = disabled;
                markPendingButton.disabled = disabled;
                selectAll.checked = selectedCount > 0 && selectedCount === checkboxes.length;
                selectAll.indeterminate = selectedCount > 0 && selectedCount < checkboxes.length;
            };

            selectAll.addEventListener('change', () => {
                checkboxes.forEach(cb => cb.checked = selectAll.checked);
                refreshBatchState();
            });
            checkboxes.forEach(cb => cb.addEventListener('change', refreshBatchState));
            refreshBatchState();
        })();
    </script>
}
