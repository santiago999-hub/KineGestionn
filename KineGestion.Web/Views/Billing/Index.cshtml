@using KineGestion.Core
@model KineGestion.Web.Models.ViewModels.BillingDashboardViewModel

@{
    ViewData["Title"] = "Cobranzas";
    var totalCountAll = Model.PendingCount + Model.PaidCount + Model.CompletedPendingCount;
    var pendingPct = totalCountAll > 0 ? Math.Round((decimal)Model.PendingCount * 100m / totalCountAll, 1) : 0m;
    var paidPct = totalCountAll > 0 ? Math.Round((decimal)Model.PaidCount * 100m / totalCountAll, 1) : 0m;
    var compPendPct = totalCountAll > 0 ? Math.Round((decimal)Model.CompletedPendingCount * 100m / totalCountAll, 1) : 0m;
    var totalEstimated = Model.PendingAmount + Model.PaidAmount;
}

<div class="kg-page-header">
    <div>
        <h2><i class="bi bi-cash-stack"></i> Cobranzas</h2>
        <p class="text-muted mb-0">Panel profesional de seguimiento de pagos, aging y efectividad</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-secondary"
           href="@Url.Action("Index", "Audit", new { entityName = "BillingBatch", action = "Create", dateFrom = Model.WeeklyBatchFrom.ToString("yyyy-MM-dd"), dateTo = Model.WeeklyBatchTo.ToString("yyyy-MM-dd") })">
            <i class="bi bi-clock-history"></i> Auditoría de lotes
        </a>
        <a class="btn btn-sm btn-outline-primary"
           href="@Url.Action("Export", "Audit", new { entityName = "BillingBatch", action = "Create", dateFrom = Model.WeeklyBatchFrom.ToString("yyyy-MM-dd"), dateTo = Model.WeeklyBatchTo.ToString("yyyy-MM-dd") })">
            <i class="bi bi-download"></i> Exportar CSV
        </a>
    </div>
</div>

@if (Model.LastBatchRequestedCount.HasValue)
{
    <div class="alert alert-info d-flex align-items-center gap-3 mb-3" role="status">
        <i class="bi bi-info-circle-fill fs-5"></i>
        <div>
            <strong>Último lote procesado:</strong>
            Solicitadas <strong>@Model.LastBatchRequestedCount</strong> • 
            Actualizadas <strong>@Model.LastBatchUpdatedCount</strong> • 
            Omitidas <strong>@Model.LastBatchSkippedCount</strong> • 
            Efectividad <strong>@Model.LastBatchEffectivenessPct?.ToString("N2")%</strong>
        </div>
    </div>
}

<!-- Resumen Ejecutivo -->
<h6 class="text-uppercase text-muted fw-semibold mb-2 mt-4" style="letter-spacing: .05em;"><i class="bi bi-grid-fill"></i> Resumen Ejecutivo</h6>
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="kg-stat-card">
            <div class="kg-stat-icon orange"><i class="bi bi-exclamation-triangle-fill"></i></div>
            <div>
                <div class="kg-stat-label">Completadas sin cobrar</div>
                <div class="kg-stat-value">@Model.CompletedPendingCount</div>
                <small class="text-muted">$ @Model.CompletedPendingAmount.ToString("N2")</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kg-stat-card">
            <div class="kg-stat-icon red"><i class="bi bi-clock-history"></i></div>
            <div>
                <div class="kg-stat-label">Pendientes (Todas)</div>
                <div class="kg-stat-value">@Model.PendingCount</div>
                <small class="text-muted">$ @Model.PendingAmount.ToString("N2")</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kg-stat-card">
            <div class="kg-stat-icon green"><i class="bi bi-check-circle-fill"></i></div>
            <div>
                <div class="kg-stat-label">Pagadas</div>
                <div class="kg-stat-value">@Model.PaidCount</div>
                <small class="text-muted">$ @Model.PaidAmount.ToString("N2")</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kg-stat-card">
            <div class="kg-stat-icon cyan"><i class="bi bi-currency-dollar"></i></div>
            <div>
                <div class="kg-stat-label">Total estimado</div>
                <div class="kg-stat-value">$ @totalEstimated.ToString("N2")</div>
                <small class="text-muted">Valor sesión: $ @Model.DefaultSessionAmount.ToString("N2")</small>
            </div>
        </div>
    </div>
</div>

<!-- Gráficos de Análisis -->
<h6 class="text-uppercase text-muted fw-semibold mb-2" style="letter-spacing: .05em;"><i class="bi bi-pie-chart-fill"></i> Análisis Visual</h6>
<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="kg-card h-100">
            <div class="kg-card-header">
                <h5 class="kg-card-header-title"><i class="bi bi-donut"></i> Distribución por estado</h5>
            </div>
            <div class="kg-card-body d-flex align-items-center justify-content-center">
                <canvas id="billingStatusChart" height="220"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="kg-card h-100">
            <div class="kg-card-header">
                <h5 class="kg-card-header-title"><i class="bi bi-hourglass-split"></i> Aging de cobranzas</h5>
            </div>
            <div class="kg-card-body d-flex align-items-center justify-content-center">
                <canvas id="billingAgingChart" height="220"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="kg-card h-100">
            <div class="kg-card-header">
                <h5 class="kg-card-header-title"><i class="bi bi-bar-chart-line"></i> Efectividad semanal</h5>
            </div>
            <div class="kg-card-body">
                <canvas id="billingTrendChart" height="220"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Aging detallado -->
<h6 class="text-uppercase text-muted fw-semibold mb-2" style="letter-spacing: .05em;"><i class="bi bi-calendar-range"></i> Antigüedad de deuda</h6>
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="kg-stat-card">
            <div class="kg-stat-icon yellow"><i class="bi bi-hourglass-top"></i></div>
            <div>
                <div class="kg-stat-label">0 - 2 días</div>
                <div class="kg-stat-value">@Model.Aging0To2DaysCount</div>
                <small class="text-muted">Reciente</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="kg-stat-card">
            <div class="kg-stat-icon orange"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <div class="kg-stat-label">3 - 7 días</div>
                <div class="kg-stat-value">@Model.Aging3To7DaysCount</div>
                <small class="text-muted">Riesgo medio</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="kg-stat-card">
            <div class="kg-stat-icon red"><i class="bi bi-hourglass-bottom"></i></div>
            <div>
                <div class="kg-stat-label">+8 días</div>
                <div class="kg-stat-value">@Model.Aging8PlusDaysCount</div>
                <small class="text-muted">Prioritario</small>
            </div>
        </div>
    </div>
</div>

@if (Model.IsWeeklyBatchEffectivenessLow)
{
    <div class="alert alert-warning d-flex align-items-center gap-2 mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <div>
            <strong>Alerta operativa:</strong>
            Efectividad semanal @Model.WeeklyBatchEffectivenessPct?.ToString("N2")% por debajo del umbral @Model.WeeklyBatchWarnThresholdPct.ToString("N2")%
        </div>
    </div>
}

@if (Model.HasTwoConsecutiveLowWeeks)
{
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-3" role="alert">
        <i class="bi bi-shield-exclamation"></i>
        <div>
            <strong>Alerta crítica:</strong>
            2 semanas consecutivas por debajo del umbral (@Model.WeeklyBatchWarnThresholdPct.ToString("N2")%)
        </div>
    </div>
}

<!-- Filtros -->
<div class="kg-card mb-4">
    <div class="kg-card-header">
        <h5 class="kg-card-header-title"><i class="bi bi-funnel-fill"></i> Filtros</h5>
    </div>
    <div class="kg-card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label">Desde</label>
                <input type="date" name="dateFrom" class="form-control" value="@Model.DateFrom.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Hasta</label>
                <input type="date" name="dateTo" class="form-control" value="@Model.DateTo.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Buscar</label>
                <input type="text" name="search" class="form-control" value="@Model.Search" placeholder="Paciente, profesional o tratamiento..." />
            </div>
            <div class="col-md-3">
                <label class="form-label">Vista</label>
                <select name="onlyCompletedPending" class="form-select">
                    @if (Model.OnlyCompletedPending)
                    {
                        <option value="true" selected>Solo completadas sin cobrar</option>
                        <option value="false">Todas las sesiones</option>
                    }
                    else
                    {
                        <option value="true">Solo completadas sin cobrar</option>
                        <option value="false" selected>Todas las sesiones</option>
                    }
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i></button>
            </div>
        </form>
    </div>
</div>

<!-- Listado -->
<div class="kg-card">
    <div class="kg-card-header">
        <h5 class="kg-card-header-title"><i class="bi bi-list-check"></i> Sesiones a cobrar</h5>
        <div class="d-flex align-items-center gap-2">
            <select id="quickPaymentFilter" class="form-select form-select-sm" style="width: 160px;">
                <option value="all">Ver todas</option>
                <option value="pending">Solo pendientes</option>
                <option value="paid">Solo pagadas</option>
            </select>
        </div>
    </div>
    <div class="kg-card-body">
        <form asp-action="MarkPaidBatch" method="post" id="batchMarkPaidForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="dateFrom" value="@Model.DateFrom.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="dateTo" value="@Model.DateTo.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="search" value="@Model.Search" />
            <input type="hidden" name="onlyCompletedPending" value="@Model.OnlyCompletedPending" />
            <input type="hidden" name="page" value="@Model.Page" />
            <input type="hidden" name="pageSize" value="@Model.PageSize" />

            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <small class="text-muted">Seleccioná sesiones para acciones masivas</small>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-success" id="markSelectedPaidBtn" disabled>
                        <i class="bi bi-check2-all"></i> Marcar pagadas
                    </button>
                    <button type="submit" formaction="@Url.Action("MarkPendingBatch", "Billing")" class="btn btn-sm btn-outline-warning" id="markSelectedPendingBtn" disabled>
                        <i class="bi bi-arrow-counterclockwise"></i> Reabrir
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 40px;">
                                <input type="checkbox" id="selectAllSessions" class="form-check-input" />
                            </th>
                            <th>Fecha/Hora</th>
                            <th>Paciente</th>
                            <th>Profesional</th>
                            <th>Tratamiento</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr class="js-billing-row" data-payment-status="@(item.PaymentStatus == PaymentStatus.Paid ? "paid" : "pending")">
                                <td>
                                    <input type="checkbox" class="form-check-input js-batch-session" name="sessionIds" value="@item.Id" />
                                </td>
                                <td><span class="fw-semibold">@item.FechaHora.ToString("dd/MM/yyyy")</span><br/><small class="text-muted">@item.FechaHora.ToString("HH:mm")</small></td>
                                <td>@item.PacienteNombre</td>
                                <td>@item.ProfesionalNombre</td>
                                <td>@item.TratamientoDescripcion</td>
                                <td class="text-center">
                                    @if (item.PaymentStatus == PaymentStatus.Paid)
                                    {
                                        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">Pagada</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Pendiente</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (item.PaymentStatus == PaymentStatus.Paid)
                                    {
                                        <form asp-action="MarkPending" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="sessionId" value="@item.Id" />
                                            <input type="hidden" name="dateFrom" value="@Model.DateFrom.ToString("yyyy-MM-dd")" />
                                            <input type="hidden" name="dateTo" value="@Model.DateTo.ToString("yyyy-MM-dd")" />
                                            <input type="hidden" name="search" value="@Model.Search" />
                                            <input type="hidden" name="onlyCompletedPending" value="@Model.OnlyCompletedPending" />
                                            <input type="hidden" name="page" value="@Model.Page" />
                                            <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                            <button class="btn btn-sm btn-outline-secondary" type="submit"><i class="bi bi-arrow-counterclockwise"></i> Reabrir</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="MarkPaid" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="sessionId" value="@item.Id" />
                                            <input type="hidden" name="dateFrom" value="@Model.DateFrom.ToString("yyyy-MM-dd")" />
                                            <input type="hidden" name="dateTo" value="@Model.DateTo.ToString("yyyy-MM-dd")" />
                                            <input type="hidden" name="search" value="@Model.Search" />
                                            <input type="hidden" name="onlyCompletedPending" value="@Model.OnlyCompletedPending" />
                                            <input type="hidden" name="page" value="@Model.Page" />
                                            <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                            <button class="btn btn-sm btn-success" type="submit"><i class="bi bi-check-lg"></i> Marcar pagada</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        (() => {
            const statusCtx = document.getElementById('billingStatusChart');
            if (statusCtx) {
                new Chart(statusCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Completadas sin cobrar', 'Pendientes', 'Pagadas'],
                        datasets: [{
                            data: [@Model.CompletedPendingCount, @Model.PendingCount, @Model.PaidCount],
                            backgroundColor: ['#f59e0b', '#ef4444', '#22c55e'],
                            borderWidth: 2,
                            borderColor: '#fff'
                        }]
                    },
                    options: {
                        plugins: { legend: { position: 'bottom' } },
                        cutout: '65%'
                    }
                });
            }

            const agingCtx = document.getElementById('billingAgingChart');
            if (agingCtx) {
                new Chart(agingCtx, {
                    type: 'bar',
                    data: {
                        labels: ['0-2 días', '3-7 días', '+8 días'],
                        datasets: [{
                            label: 'Cantidad',
                            data: [@Model.Aging0To2DaysCount, @Model.Aging3To7DaysCount, @Model.Aging8PlusDaysCount],
                            backgroundColor: ['#fbbf24', '#fb923c', '#f87171'],
                            borderRadius: 6
                        }]
                    },
                    options: {
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                    }
                });
            }

            const trendCtx = document.getElementById('billingTrendChart');
            if (trendCtx) {
                new Chart(trendCtx, {
                    type: 'bar',
                    data: {
                        labels: [@Html.Raw(string.Join(",", Model.WeeklyTrendPoints.Select(p => "'" + p.Label + "'")))],
                        datasets: [{
                            label: 'Efectividad %',
                            data: [@Html.Raw(string.Join(",", Model.WeeklyTrendPoints.Select(p => p.EffectivenessPct.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))))],
                            backgroundColor: '#06b6d4',
                            borderRadius: 6
                        }]
                    },
                    options: {
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, max: 100, ticks: { callback: v => v + '%' } }
                        }
                    }
                });
            }

            const selectAll = document.getElementById('selectAllSessions');
            const markPaidButton = document.getElementById('markSelectedPaidBtn');
            const markPendingButton = document.getElementById('markSelectedPendingBtn');
            const quickFilter = document.getElementById('quickPaymentFilter');
            const checkboxes = Array.from(document.querySelectorAll('.js-batch-session'));
            const rows = Array.from(document.querySelectorAll('.js-billing-row'));

            if (!selectAll || !markPaidButton || !markPendingButton || !quickFilter || checkboxes.length === 0) return;

            const refreshBatchState = () => {
                const selectedCount = checkboxes.filter(cb => cb.checked).length;
                const disabled = selectedCount === 0;
                markPaidButton.disabled = disabled;
                markPendingButton.disabled = disabled;
                selectAll.checked = selectedCount > 0 && selectedCount === checkboxes.length;
                selectAll.indeterminate = selectedCount > 0 && selectedCount < checkboxes.length;
            };

            const applyQuickFilter = () => {
                const mode = quickFilter.value;
                rows.forEach(row => {
                    if (mode === 'all') { row.style.display = ''; return; }
                    row.style.display = row.dataset.paymentStatus === mode ? '' : 'none';
                });
            };

            selectAll.addEventListener('change', () => { checkboxes.forEach(cb => cb.checked = selectAll.checked); refreshBatchState(); });
            quickFilter.addEventListener('change', applyQuickFilter);
            checkboxes.forEach(cb => cb.addEventListener('change', refreshBatchState));
            applyQuickFilter();
            refreshBatchState();
        })();
    </script>
}