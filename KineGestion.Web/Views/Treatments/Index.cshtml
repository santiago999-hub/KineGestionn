@model KineGestion.Web.Models.ViewModels.TreatmentIndexViewModel

@{
    ViewData["Title"] = "Tratamientos";
}

<div class="kg-page-header">
    <div>
        <h2>Tratamientos</h2>
        <p class="text-muted mb-0">Planes terapéuticos asignados a pacientes</p>
    </div>
    <a asp-action="Create" class="btn-kg-primary">
        <i class="bi bi-journal-plus"></i> Nuevo Tratamiento
    </a>
</div>

<div class="kg-card">
    <div class="kg-card-header">
        <h5 class="kg-card-header-title">
            <i class="bi bi-journal-medical"></i> Listado de Tratamientos
        </h5>
        <span class="kg-badge kg-badge-muted">@Model.TotalCount registros</span>
    </div>

    <form method="get" class="px-3 pt-3 pb-1">
        <div class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label small text-muted">Buscar</label>
                <input name="search" value="@Model.Search" class="form-control" placeholder="Descripción o nombre de paciente" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn-kg-primary w-100"><i class="bi bi-search"></i></button>
                <a asp-action="Index" class="btn-kg-outline w-100"><i class="bi bi-x-lg"></i></a>
            </div>
        </div>
    </form>

    @if (!Model.Items.Any())
    {
        <partial name="_EmptyState" model="@(new KineGestion.Web.Models.ViewModels.EmptyStateViewModel { IconClass = "bi bi-journal-medical", Title = "Sin tratamientos registrados", Text = "Creá el primer plan terapéutico para un paciente.", ActionName = "Create", ActionText = "Crear el primero", ActionIcon = "bi bi-journal-plus" })" />
    }
    else
    {
        <div class="table-responsive">
            <table class="kg-table">
                <thead>
                    <tr>
                        <th>Tratamiento</th>
                        <th>Paciente</th>
                        <th>Progreso</th>
                        <th>Fecha inicio</th>
                        <th class="kg-table-actions-header">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="kg-cell-user">
                                    <div class="kg-cell-avatar is-square is-green">
                                        <i class="bi bi-journal-medical"></i>
                                    </div>
                                    <div class="kg-cell-primary">@t.Descripcion</div>
                                </div>
                            </td>
                            <td>@(t.PacienteNombre ?? "—")</td>
                            <td>
                                @{
                                    var pct = t.CantidadSesionesTotales > 0
                                        ? (int)Math.Round((double)t.SesionesRealizadas / t.CantidadSesionesTotales * 100)
                                        : 0;
                                    var barColor = pct >= 100 ? "#16a34a" : pct >= 50 ? "#2563eb" : "#f59e0b";
                                }
                                <div class="kg-progress-cell">
                                    <div class="kg-progress-head">
                                        <span class="kg-cell-primary">@t.SesionesRealizadas / @t.CantidadSesionesTotales</span>
                                        <span class="kg-cell-meta">@pct%</span>
                                    </div>
                                    <div class="kg-progress-track">
                                        <div class="kg-progress-fill" style="width:@(pct)%;background:@barColor"></div>
                                    </div>
                                </div>
                            </td>
                            <td>@t.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="kg-action-btns kg-action-btns-end">
                                    <a asp-action="Details" asp-route-id="@t.Id" class="kg-action-btn view" title="Ver detalle"><i class="bi bi-eye-fill"></i></a>
                                    <a asp-action="Edit" asp-route-id="@t.Id" class="kg-action-btn edit" title="Editar"><i class="bi bi-pencil-fill"></i></a>
                                    <a asp-action="Delete" asp-route-id="@t.Id" class="kg-action-btn del" title="Eliminar"><i class="bi bi-trash-fill"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="kg-table-footer">
            Mostrando @Model.Items.Count() de @Model.TotalCount tratamientos
        </div>

        var paginationRouteValues = new Dictionary<string, string>();
        paginationRouteValues["pageSize"] = Model.PageSize.ToString();
        if (!string.IsNullOrWhiteSpace(Model.Search)) { paginationRouteValues["search"] = Model.Search!; }
        <partial name="_Pagination" model="@(new KineGestion.Web.Models.ViewModels.PaginationViewModel { Page = Model.Page, TotalPages = Model.TotalPages, Action = "Index", RouteValues = paginationRouteValues })" />
    }
</div>
