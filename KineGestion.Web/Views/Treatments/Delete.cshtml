@model KineGestion.Web.Models.ViewModels.TreatmentViewModel

@{
    ViewData["Title"] = "Eliminar Tratamiento";
}

<div class="kg-page-header">
    <div>
        <h2>Eliminar Tratamiento</h2>
        <p class="text-muted mb-0">Esta acción es permanente</p>
    </div>
    <a asp-action="Index" class="btn-kg-outline">
        <i class="bi bi-arrow-left"></i> Cancelar
    </a>
</div>

<div class="kg-form-card is-danger">
    <div class="kg-form-header is-danger">
        <div class="kg-form-header-icon danger"><i class="bi bi-exclamation-triangle-fill"></i></div>
        <div>
            <h4>¿Eliminar este tratamiento?</h4>
            <p class="kg-text-danger">El tratamiento <strong>@Model.Descripcion</strong> del paciente <strong>@Model.PacienteNombre</strong> será eliminado permanentemente.</p>
        </div>
    </div>
    @if ((int)ViewBag.SessionCount > 0)
    {
        <div class="alert alert-warning mx-4 mt-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>No se puede eliminar este tratamiento</strong> porque tiene <strong>@ViewBag.SessionCount sesión(es)</strong> registrada(s). Eliminá primero esas sesiones.
        </div>
    }
    <div class="kg-form-body">
        <div class="kg-detail-grid">
            <div class="kg-detail-item">
                <dt>Descripción</dt>
                <dd>@Model.Descripcion</dd>
            </div>
            <div class="kg-detail-item">
                <dt>Paciente</dt>
                <dd>@(Model.PacienteNombre ?? "—")</dd>
            </div>
            <div class="kg-detail-item">
                <dt>Sesiones totales</dt>
                <dd>@Model.CantidadSesionesTotales</dd>
            </div>
            <div class="kg-detail-item">
                <dt>Fecha de inicio</dt>
                <dd>@Model.FechaInicio.ToString("dd/MM/yyyy")</dd>
            </div>
        </div>
    </div>
    <div class="kg-form-footer">
        <a asp-action="Index" class="btn-kg-outline"><i class="bi bi-x-lg"></i> Cancelar</a>
        @if ((int)ViewBag.SessionCount == 0)
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-kg-danger">
                    <i class="bi bi-trash-fill"></i> Sí, eliminar
                </button>
            </form>
        }
    </div>
</div>
