@model KineGestion.Web.Models.ViewModels.SessionViewModel
@using KineGestion.Core

@{
    ViewData["Title"] = "Cancelar Sesión";
    var professionalId = Model.ProfesionalId;
}

<div class="kg-page-header">
    <div>
        <h2>Cancelar Sesión</h2>
        <p class="text-muted mb-0">Registrá el motivo y, si querés, recuperá el turno con una reprogramación</p>
    </div>
    <a asp-action="Index" class="btn-kg-outline">
        <i class="bi bi-arrow-left"></i> Volver
    </a>
</div>

<div class="kg-form-card" style="border-top: 3px solid var(--kg-danger)">
    <div class="kg-form-header" style="background:#fff5f5">
        <div class="kg-form-header-icon" style="background:#fee2e2;color:#dc2626"><i class="bi bi-x-circle-fill"></i></div>
        <div>
            <h4>¿Cancelar esta sesión?</h4>
            <p style="color:#dc2626">La sesión de <strong>@Model.PacienteNombre</strong> del <strong>@Model.FechaHora.ToString("dd/MM/yyyy HH:mm")</strong> será marcada como cancelada.</p>
        </div>
    </div>

    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="kg-form-body" id="cancel-form">
        @Html.AntiForgeryToken()

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label small text-muted" asp-for="CancellationReason">Motivo de cancelación *</label>
                <select asp-for="CancellationReason" asp-items="Model.MotivosCancelacion" class="form-select" required>
                    <option value="">Seleccioná un motivo</option>
                </select>
                <span asp-validation-for="CancellationReason" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label class="form-label small text-muted" asp-for="CancellationObs">Observación (opcional)</label>
                <textarea asp-for="CancellationObs" class="form-control" rows="2" maxlength="2000" placeholder="Detalle del motivo, si corresponde"></textarea>
                <span asp-validation-for="CancellationObs" class="text-danger small"></span>
            </div>
        </div>

        <div class="kg-form-footer px-0 pb-0">
            <a asp-action="Index" class="btn-kg-outline"><i class="bi bi-x-lg"></i> No cancelar</a>
            <button type="submit" class="btn-kg-danger">
                <i class="bi bi-x-circle-fill"></i> Confirmar cancelación
            </button>
        </div>
    </form>
</div>

<div class="kg-card mt-4" id="recapture-card">
    <div class="kg-card-header">
        <h5 class="kg-card-header-title">
            <i class="bi bi-arrow-repeat"></i> Recuperar el turno (reprogramación)
        </h5>
        <div class="d-flex gap-2">
            <button type="button" class="btn-kg-outline" id="btn-load-slots">
                <i class="bi bi-calendar2-week-fill"></i> Sugerir turnos alternativos
            </button>
            <button type="button" class="btn-kg-outline" id="btn-load-agenda">
                <i class="bi bi-calendar3"></i> Ver agenda libre
            </button>
        </div>
    </div>
    <div class="kg-card-body">
        <div class="alert alert-info py-2 small mb-3">
            <i class="bi bi-info-circle me-1"></i>
            Las sugerencias y la agenda muestran turnos <strong>solo del profesional</strong> de esta sesión
            (<strong>@Model.ProfesionalNombre</strong>). Para ver toda la diversidad de opciones y combinaciones,
            consultá el menú principal de turnos.
        </div>

        <div class="text-muted small mb-2">Si cancelaste la sesión, podés ofrecer al paciente un nuevo turno en el acto con el mismo profesional y tratamiento.</div>

        <div id="slots-loading" class="d-none text-muted">
            <span class="spinner-border spinner-border-sm me-2" role="status"></span>Buscando horarios...
        </div>

        <div id="slots-empty" class="d-none kg-empty">
            <div class="kg-empty-icon"><i class="bi bi-calendar2-x"></i></div>
            <h5>Sin turnos disponibles</h5>
            <p>No se encontraron horarios alternativos en los próximos días.</p>
        </div>

        <div id="slots-label" class="d-none text-muted small mb-2"></div>
        <div class="row g-3" id="slots-list"></div>

        <form asp-action="Reprogram" asp-route-id="@Model.Id" method="post" id="reprogram-form" class="d-none mt-3" style="border-top:1px solid var(--kg-border);padding-top:1rem">
            @Html.AntiForgeryToken()
            <input type="hidden" name="reason" id="reprogram-reason" />
            <input type="hidden" name="observation" id="reprogram-observation" />
            <input type="hidden" name="newFechaHora" id="reprogram-newfecha" />
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn-kg-outline" id="btn-cancel-reprogram"><i class="bi bi-x-lg"></i> Salir</button>
                <button type="submit" class="btn-kg-primary">
                    <i class="bi bi-arrow-repeat"></i> Reprogramar para <span id="reprogram-display"></span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var professionalId = @professionalId;
            var antiForgeryToken = $('input[name="__RequestVerificationToken"]').first().val();

            var reasonSelect = document.getElementById('CancellationReason');
            var obsInput = document.getElementById('CancellationObs');
            var slotsList = document.getElementById('slots-list');
            var slotsLabel = document.getElementById('slots-label');

            function currentReason() {
                return reasonSelect ? reasonSelect.value : '';
            }

            function fillReprogramFields() {
                var reason = currentReason();
                var obs = obsInput ? obsInput.value : '';
                document.getElementById('reprogram-reason').value = reason;
                document.getElementById('reprogram-observation').value = obs;
                if (!reason) {
                    reasonSelect.setCustomValidity('Para reprogramar también necesitás elegir un motivo de cancelación.');
                } else {
                    reasonSelect.setCustomValidity('');
                }
            }

            function canProceedWithReason() {
                fillReprogramFields();
                if (!currentReason()) {
                    reasonSelect.focus();
                    reasonSelect.reportValidity();
                    return false;
                }
                return true;
            }

            function clearSlots() {
                document.getElementById('slots-loading').classList.remove('d-none');
                document.getElementById('slots-empty').classList.add('d-none');
                document.getElementById('slots-label').classList.add('d-none');
                slotsList.innerHTML = '';
                document.getElementById('reprogram-form').classList.add('d-none');
            }

            function renderSuggested(data) {
                document.getElementById('slots-loading').classList.add('d-none');
                slotsLabel.classList.add('d-none');
                if (!data || data.length === 0) {
                    document.getElementById('slots-empty').classList.remove('d-none');
                    return;
                }
                data.forEach(function (slot) {
                    var col = document.createElement('div');
                    col.className = 'col-md-4 col-lg-3';
                    col.innerHTML =
                        '<button type="button" class="btn-kg-outline w-100 py-2 kg-slot-option" data-fecha="' + slot.fecha + '" data-display="' + slot.display + '">' +
                            '<i class="bi bi-calendar2-plus"></i> ' + slot.display +
                        '</button>';
                    slotsList.appendChild(col);
                });
            }

            function renderAgenda(data) {
                document.getElementById('slots-loading').classList.add('d-none');
                if (!data || data.length === 0) {
                    document.getElementById('slots-empty').classList.remove('d-none');
                    return;
                }

                var groups = {};
                data.forEach(function (slot) {
                    if (!groups[slot.day]) groups[slot.day] = [];
                    groups[slot.day].push(slot);
                });

                Object.keys(groups).forEach(function (day) {
                    var daySlots = groups[day];
                    var fecha = new Date(day + 'T12:00:00');
                    var dayLabel = fecha.toLocaleDateString('es-AR', { weekday: 'short', day: 'numeric', month: 'short' });

                    var dayCol = document.createElement('div');
                    dayCol.className = 'col-md-4 col-lg-3';
                    dayCol.innerHTML =
                        '<div class="kg-slot-day mb-1"><i class="bi bi-calendar-day"></i> ' + dayLabel + '</div>' +
                        '<div class="d-flex flex-wrap gap-1 mb-3">' +
                            daySlots.map(function (slot) {
                                return '<button type="button" class="btn-kg-outline btn-sm kg-slot-option" data-fecha="' + slot.fecha + '" data-display="' + slot.display + '">' + slot.display.split(' ')[1] + '</button>';
                            }).join('') +
                        '</div>';
                    slotsList.appendChild(dayCol);
                });

                slotsLabel.classList.remove('d-none');
                slotsLabel.textContent = 'Agenda libre de ' + professionalIdName + ' (próximos ' + data.length + ' turnos). Tocá un horario para elegirlo.';
            }

            function loadSlots(url, renderer, label) {
                if (!canProceedWithReason()) return;
                clearSlots();
                $.getJSON(url)
                    .done(renderer)
                    .fail(function () {
                        document.getElementById('slots-loading').classList.add('d-none');
                        document.getElementById('slots-empty').classList.remove('d-none');
                        document.getElementById('slots-empty').querySelector('h5').textContent = 'Error al buscar turnos';
                    });
            }

            // Reemplazamos el id del profesional por el nombre para el label de agenda
            var professionalIdName = '@Model.ProfesionalNombre';

            document.getElementById('btn-load-slots').addEventListener('click', function () {
                loadSlots('@Url.Action("AvailableSlots", "Sessions")?professionalId=' + professionalId, renderSuggested);
            });

            document.getElementById('btn-load-agenda').addEventListener('click', function () {
                loadSlots('@Url.Action("AgendaSlots", "Sessions")?professionalId=' + professionalId, renderAgenda);
            });

            slotsList.addEventListener('click', function (e) {
                var btn = e.target.closest('.kg-slot-option');
                if (!btn) return;
                document.getElementById('reprogram-newfecha').value = btn.dataset.fecha;
                document.getElementById('reprogram-display').textContent = btn.dataset.display;
                document.getElementById('reprogram-form').classList.remove('d-none');
                Array.prototype.forEach.call(document.querySelectorAll('.kg-slot-option'), function (b) {
                    b.classList.remove('active');
                });
                btn.classList.add('active');
            });

            document.getElementById('btn-cancel-reprogram').addEventListener('click', function () {
                document.getElementById('reprogram-form').classList.add('d-none');
            });
        })();
    </script>
}
